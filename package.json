{
  "name": "kernseite-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Website von KERNSEITE – Eliyah Korb (Digitalstudio aus Würzburg)",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run build:production",
    "build:ci": "cross-env KERNSEITE_BUILD_MODE=ci astro build",
    "build:production": "cross-env KERNSEITE_BUILD_MODE=production astro build",
    "preview": "astro preview",
    "copy-fonts": "node scripts/copy-fonts.mjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa": "node scripts/run-qa.mjs",
    "test:e2e": "playwright test",
    "assemble": "node scripts/assemble-deploy.mjs",
    "guard:no-fixture": "node scripts/guard-no-fixture.mjs"
  },
  "dependencies": {
    "astro": "^7.1.3",
    "@astrojs/sitemap": "^3.7.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
