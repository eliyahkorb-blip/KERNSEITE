---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import CtaBanner from '../../components/CtaBanner.astro';
const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Projekte', path: '/arbeiten/' },
];
---

<PageLayout
  title="Webdesign-Referenzen – ausgewählte Kundenprojekte"
  description="Websites für Kaya Döner Himmelstadt und Anna-Lena’s Kinderkörbchen: Einblicke in Gestaltung, Seitenstruktur und Umsetzung von KERNSEITE."
  h1="So unterschiedlich wie die Unternehmen dahinter."
  lead="Zwei umgesetzte Kundenwebsites. Schau dir an, welche Aufgaben der jeweilige Auftritt löst und wie daraus Struktur und Gestaltung entstanden sind."
  breadcrumbs={breadcrumbs}
>
  <section class="section section--cream">
    <div class="content">
      <h2 class="visually-hidden">Ausgewählte Kundenprojekte</h2><ProjectGrid />
    </div>
  </section>
  <CtaBanner
    title="Wie könnte dein Auftritt aussehen?"
    text="Zeig uns dein Unternehmen und erzähl, was deine Website leisten soll. Daraus entwickeln wir einen passenden Vorschlag."
  />
</PageLayout>
