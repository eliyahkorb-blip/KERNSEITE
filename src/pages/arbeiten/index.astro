---
import PageLayout from '../../layouts/PageLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { works, workFilters } from '../../config/cases';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Arbeiten', path: '/arbeiten/' },
];
---

<PageLayout
  title="Arbeiten"
  description="Ausgewählte Referenzen und Konzeptstudien von KERNSEITE. Reale Projekte sind als Referenz gekennzeichnet, fiktive Beispiele klar als Konzeptstudie."
  eyebrow="Arbeiten"
  h1="Arbeiten, die mehr zeigen als schöne Screens."
  lead="Echte, umgesetzte Projekte stehen als Referenz vorn. Ergänzend zeigen wir eigenständig entwickelte Konzeptstudien – klar als solche gekennzeichnet, ohne erfundene Ergebnisse oder Kennzahlen."
  breadcrumbs={breadcrumbs}
>
  <section class="section section--bright">
    <div class="content">
      <div class="filterbar" role="group" aria-label="Arbeiten filtern">
        <button type="button" class="filterbar__btn" data-filter="all" aria-pressed="true">
          Alle
        </button>
        {
          workFilters.map((f) => (
            <button type="button" class="filterbar__btn" data-filter={f.key} aria-pressed="false">
              {f.label}
            </button>
          ))
        }
      </div>

      <ul class="works" role="list" data-works>
        {works.map((work) => <WorkCard work={work} />)}
      </ul>
      <p class="works__empty" data-empty hidden>
        Für diesen Filter gibt es aktuell keine Arbeiten.
      </p>
    </div>
  </section>

  <CtaBanner
    title="Dein Projekt wird die nächste Arbeit."
    text="Lass uns über deinen Auftritt sprechen – ehrlich, unverbindlich und ohne Paket-Verkauf."
    ctaLabel="Projekt besprechen"
    ctaHref="/kontakt/"
    secondaryLabel="Leistungen ansehen"
    secondaryHref="/leistungen/"
  />
</PageLayout>

<style>
  .filterbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block-end: var(--space-2xl);
  }
  .filterbar__btn {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background: var(--color-bright);
    color: var(--text-muted);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .filterbar__btn:hover {
    border-color: var(--color-graphite);
    color: var(--text);
  }
  .filterbar__btn[aria-pressed='true'] {
    background: var(--color-graphite);
    border-color: var(--color-graphite);
    color: var(--color-bright);
  }

  .works {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .works__empty {
    margin-block-start: var(--space-xl);
    color: var(--text-muted);
  }

  @media (min-width: 48rem) {
    .works {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .works {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  // Client-seitiger Filter für die Arbeiten-Übersicht.
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const items = Array.from(document.querySelectorAll<HTMLElement>('.workcard-li'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  function apply(filter: string) {
    let visible = 0;
    items.forEach((item) => {
      const filters = (item.dataset.filters ?? '').split(' ');
      const show = filter === 'all' || filters.includes(filter);
      item.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible !== 0;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));
      apply(btn.dataset.filter ?? 'all');
    });
  });
</script>
