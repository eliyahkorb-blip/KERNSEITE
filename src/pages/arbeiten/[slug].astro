---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CaseMockup from '../../components/CaseMockup.astro';
import ReferenceImage from '../../components/ReferenceImage.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { works, type Work } from '../../config/cases';
import { getService, type ServiceKey } from '../../config/services';
import { breadcrumbJsonLd } from '../../lib/jsonld';

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

interface Props {
  work: Work;
}
const { work } = Astro.props;

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Arbeiten', path: '/arbeiten/' },
  { name: work.title, path: work.href },
];
---

{
  work.kind === 'project' ? (
    <BaseLayout
      title={work.title}
      description={`${work.tagline}`.slice(0, 155)}
      jsonLd={[breadcrumbJsonLd(breadcrumbs)]}
    >
      {/* 1. Große visuelle Eröffnung */}
      <header class="case-hero section--paper">
        <div class="content">
          <Breadcrumbs items={breadcrumbs} />
          <span class="badge badge--reference case-hero__badge">Referenz</span>
          <div class="case-hero__grid">
            <div>
              <p class="eyebrow">{work.category}</p>
              <h1 class="case-hero__title">{work.title}</h1>
              <p class="lead case-hero__tagline">{work.tagline}</p>
              <a
                class="btn btn--primary case-hero__live"
                href={work.liveUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Live ansehen: {work.liveLabel}
              </a>
            </div>
            <div class="case-hero__media">
              <ReferenceImage
                shot={work.screenshotDesktop}
                variant="desktop"
                eager
                pending={!work.verified}
              />
            </div>
          </div>
        </div>
      </header>

      {/* 2. Fakten */}
      <section class="section section--bright section--tight">
        <div class="content">
          <dl class="factbar">
            <div>
              <dt>Auftraggeber</dt>
              <dd>{work.client}</dd>
            </div>
            <div>
              <dt>Branche</dt>
              <dd>{work.industryLabel}</dd>
            </div>
            <div>
              <dt>Live-Website</dt>
              <dd>
                <a href={work.liveUrl} target="_blank" rel="noopener noreferrer">
                  {work.liveLabel}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </section>

      {/* 3. + 4. Ausgangssituation / Lösung */}
      <section class="section section--paper">
        <div class="content story">
          <article class="story__block">
            <p class="eyebrow">Ausgangssituation</p>
            <p class="story__text">{work.situation}</p>
          </article>
          <article class="story__block">
            <p class="eyebrow">Umgesetzte Lösung</p>
            <p class="story__text">{work.solution}</p>
          </article>
        </div>
      </section>

      {/* 5. Leistungsumfang */}
      <section class="section section--muted">
        <div class="content">
          <div class="band-head">
            <p class="eyebrow">Leistungsumfang</p>
            <h2 class="section-title">Was umgesetzt wurde.</h2>
          </div>
          <ul class="scopelist" role="list">
            {work.scope.map((s) => (
              <li>{s}</li>
            ))}
          </ul>
        </div>
      </section>

      {/* 6. Desktop + Mobile Darstellung */}
      <section class="section section--bright">
        <div class="content">
          <div class="band-head">
            <p class="eyebrow">Darstellung</p>
            <h2 class="section-title">Desktop und mobil.</h2>
          </div>
          <div class="shots">
            <ReferenceImage
              shot={work.screenshotDesktop}
              variant="desktop"
              pending={!work.verified}
            />
            <div class="shots__phone">
              <ReferenceImage
                shot={work.screenshotMobile}
                variant="phone"
                pending={!work.verified}
              />
            </div>
          </div>
          {!work.verified && (
            <p class="pending-note">
              Hinweis: Die Screenshots sind aktuell klar gekennzeichnete Platzhalter. Die echten
              Website-Aufnahmen werden ergänzt.
            </p>
          )}
        </div>
      </section>

      <CtaBanner
        title="So ein Auftritt für dein Unternehmen?"
        text="Erzähl kurz, was du vorhast – wir sagen ehrlich, was sinnvoll ist."
        ctaLabel="Projekt anfragen"
        ctaHref="/kontakt/"
        secondaryLabel="Weitere Arbeiten"
        secondaryHref="/arbeiten/"
      />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`${work.title} · Konzeptstudie`}
      description={`Konzeptstudie (kein Kundenprojekt): ${work.tagline} ${work.situation}`.slice(
        0,
        155,
      )}
      jsonLd={[breadcrumbJsonLd(breadcrumbs)]}
    >
      {/* Konzeptstudie – klar gekennzeichnet */}
      <header class="case-hero section--paper">
        <div class="content">
          <Breadcrumbs items={breadcrumbs} />
          <span class="badge badge--concept case-hero__badge">{work.badge}</span>
          <div class="case-hero__grid">
            <div>
              <p class="eyebrow">{work.industryLabel}</p>
              <h1 class="case-hero__title">{work.title}</h1>
              <p class="lead case-hero__tagline">{work.tagline}</p>
            </div>
            <div class="case-hero__media">
              <CaseMockup
                theme={work.mockupTheme}
                brand={work.title}
                tagline={work.tagline}
                industryLabel={work.industryLabel}
              />
            </div>
          </div>
        </div>
      </header>

      <section class="section section--bright section--tight">
        <div class="content">
          <dl class="factbar">
            <div>
              <dt>Auftraggeber</dt>
              <dd>Fiktiv – Konzeptstudie</dd>
            </div>
            <div>
              <dt>Branche</dt>
              <dd>{work.industryLabel}</dd>
            </div>
            <div>
              <dt>Leistungen</dt>
              <dd>{work.services.map((k) => getService(k as ServiceKey).label).join(', ')}</dd>
            </div>
          </dl>
        </div>
      </section>

      <section class="section section--paper">
        <div class="content story">
          <article class="story__block">
            <p class="eyebrow">Ausgangssituation</p>
            <p class="story__text">{work.situation}</p>
          </article>
          <article class="story__block">
            <p class="eyebrow">Ziel</p>
            <p class="story__text">{work.goal}</p>
          </article>
          <article class="story__block">
            <p class="eyebrow">Strategie</p>
            <p class="story__text">{work.strategy}</p>
          </article>
          <article class="story__block">
            <p class="eyebrow">Designsystem</p>
            <p class="story__text">{work.designSystem}</p>
          </article>
        </div>
      </section>

      <section class="section section--muted">
        <div class="content">
          <div class="band-head">
            <p class="eyebrow">Website-Ausschnitte</p>
            <h2 class="section-title">Was den Auftritt ausmacht.</h2>
          </div>
          <ul class="scopelist" role="list">
            {work.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--bright">
        <div class="content honesty">
          <div class="honesty__card">
            <p class="eyebrow">Belegbare Ergebnisse</p>
            <p>
              Dies ist eine Konzeptstudie. Wir weisen bewusst keine Kennzahlen oder Ergebnisse aus.
              Belegbare Resultate zeigen wir ausschließlich bei echten, freigegebenen Projekten.
            </p>
          </div>
          <div class="honesty__card">
            <p class="eyebrow">Kundenstimme</p>
            <p>
              Kundenstimmen veröffentlichen wir nur mit ausdrücklicher Freigabe. Für diese
              Konzeptstudie liegt keine vor.
            </p>
          </div>
        </div>
      </section>

      <CtaBanner
        title="Stell dir das für dein Unternehmen vor."
        text="Aus einer Konzeptstudie wird ein echter Auftritt, sobald wir dein Unternehmen kennen."
        ctaLabel="Projekt besprechen"
        ctaHref="/kontakt/"
        secondaryLabel="Weitere Arbeiten"
        secondaryHref="/arbeiten/"
      />
    </BaseLayout>
  )
}

<style>
  .case-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) var(--section-y);
  }
  .case-hero__badge {
    margin-block: var(--space-lg) var(--space-lg);
  }
  .badge--reference {
    border-color: var(--color-ultramarine);
    color: #fff;
    background: var(--color-ultramarine);
  }
  .case-hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .case-hero__title {
    font-size: clamp(2.25rem, 1rem + 5vw, 4.5rem);
    margin-block: var(--space-sm) var(--space-md);
  }
  .case-hero__tagline {
    max-width: 48ch;
  }
  .case-hero__live {
    margin-block-start: var(--space-lg);
  }
  @media (min-width: 64rem) {
    .case-hero__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-4xl);
    }
  }

  .factbar {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
  }
  .factbar dt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: 0.25rem;
  }
  .factbar dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h4);
  }
  .factbar a {
    color: var(--brand-strong);
  }
  @media (min-width: 48rem) {
    .factbar {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .story {
    display: grid;
    gap: var(--space-2xl);
  }
  .story__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 62ch;
  }
  @media (min-width: 48rem) {
    .story {
      grid-template-columns: 1fr 1fr;
    }
  }

  .band-head {
    display: grid;
    gap: var(--space-sm);
    margin-block-end: var(--space-xl);
  }
  .scopelist {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .scopelist li {
    position: relative;
    padding-inline-start: 1.6rem;
    font-size: var(--fs-lead);
  }
  .scopelist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--color-ultramarine);
  }

  .shots {
    display: grid;
    gap: var(--space-2xl);
    align-items: end;
  }
  .shots__phone {
    justify-self: center;
  }
  @media (min-width: 64rem) {
    .shots {
      grid-template-columns: 1.6fr 0.7fr;
    }
  }
  .pending-note {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 62ch;
  }

  .honesty {
    display: grid;
    gap: var(--grid-gap);
  }
  .honesty__card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--color-bright);
    max-width: 60ch;
  }
  .honesty__card p:not(.eyebrow) {
    color: var(--text-muted);
  }
  @media (min-width: 48rem) {
    .honesty {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
