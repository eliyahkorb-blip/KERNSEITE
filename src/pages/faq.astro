---
import PageLayout from '../layouts/PageLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { faqs } from '../config/faq';
import { faqPageJsonLd } from '../lib/jsonld';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];
---

<PageLayout
  title="Häufige Fragen"
  description="Antworten zu Kosten, Ablauf, Templates, Hosting, SEO/GEO, Datenschutz, Verträgen und Partnern – konkret und ehrlich, ohne Erfolgsgarantien."
  eyebrow="FAQ"
  h1="Häufige Fragen, ehrlich beantwortet."
  lead="Von Kosten über Ablauf bis Datenschutz: die wichtigsten Fragen – konkret beantwortet und ohne Versprechen, die niemand halten kann."
  breadcrumbs={breadcrumbs}
  extraJsonLd={[faqPageJsonLd(faqs)]}
>
  <section class="section section--paper">
    <div class="content faq-page">
      <FaqAccordion items={faqs} openFirst />
    </div>
  </section>

  <CtaBanner
    title="Deine Frage war nicht dabei?"
    text="Stell sie uns direkt – wir antworten ehrlich und ohne Verkaufsdruck."
    ctaLabel="Frage stellen"
    ctaHref="/kontakt/"
    secondaryLabel="Leistungen ansehen"
    secondaryHref="/leistungen/"
  />
</PageLayout>

<style>
  .faq-page {
    max-width: 900px;
  }
</style>
