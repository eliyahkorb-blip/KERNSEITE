---
import PageLayout from '../../layouts/PageLayout.astro';
import IndustryGrid from '../../components/IndustryGrid.astro';
import AccentWord from '../../components/AccentWord.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Branchen', path: '/branchen/' },
];
---

<PageLayout
  title="Branchen"
  description="KERNSEITE gestaltet Websites für Handwerk, Praxen, Gastronomie & Hotels, lokale Dienstleister und den B2B-Mittelstand – jede Branche mit eigenständigem Inhalt."
  h1Slot
  variant="dark"
  lead="Jede Branche hat eigene Fragen, eigene Zielgruppen und eigene Wege zur Anfrage. Deshalb bekommt jede Branche einen eigenständigen Auftritt – keinen Textbaustein mit ausgetauschtem Wort."
  breadcrumbs={breadcrumbs}
>
  <h1 slot="h1">Gute Gestaltung versteht das <AccentWord>Geschäft</AccentWord> dahinter.</h1>

  <section class="section section--paper">
    <div class="content">
      <IndustryGrid />
    </div>
  </section>

  <CtaBanner
    title="Deine Branche ist nicht dabei?"
    text="Wir arbeiten uns in dein Geschäft ein. Erzähl uns, worauf es bei dir ankommt."
    ctaLabel="Projekt besprechen"
    ctaHref="/kontakt/"
    secondaryLabel="Leistungen ansehen"
    secondaryHref="/leistungen/"
  />
</PageLayout>
