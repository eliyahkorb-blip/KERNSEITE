---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCinematic from '../components/HeroCinematic.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessBand from '../components/ProcessBand.astro';
import ReferenceImage from '../components/ReferenceImage.astro';
import IndustryList from '../components/IndustryList.astro';
import GoogleProfile from '../components/GoogleProfile.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';

import { site } from '../config/site';
import { services } from '../config/services';
import { featuredProjects } from '../config/cases';
import { processShort } from '../config/process';
import { homeFaqs } from '../config/faq';

const coreService = services.find((s) => s.isCore);
const addOnServices = services.filter((s) => !s.isCore);

const problems = [
  'Der Auftritt wirkt schwächer als das Unternehmen dahinter.',
  'Google versteht Angebot und Standort nicht eindeutig.',
  'Anfragen gehen durch unklare Nutzerführung verloren.',
  'Gute Leistungen wirken online austauschbar.',
  'Auf dem Smartphone bricht die Seite die Geduld der Besucher.',
];

const websiteProcess = [
  'Strategie',
  'Struktur',
  'Design',
  'Entwicklung',
  'Veröffentlichung',
  'Betreuung',
];
---

<BaseLayout
  title="Individuelle Websites für Unternehmen mit Anspruch"
  description={site.shortDescription}
>
  <HeroCinematic />

  <!-- PROBLEM -->
  <section class="section section--sand">
    <div class="content problem reveal">
      <div class="problem__head">
        <p class="eyebrow">Der ehrliche Blick</p>
        <h2 class="section-title">Eine schwache Website kostet mehr als eine neue.</h2>
      </div>
      <ul class="problem__list" role="list">
        {problems.map((p) => <li class="problem__item">{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- KERNLEISTUNG: die Website ist der Kern -->
  <section class="section section--bright">
    <div class="content reveal">
      <div class="section-head kern__head">
        <p class="eyebrow">Kernleistung</p>
        <h2 class="section-title section-title--wide">
          Die Website ist der Kern. Alles Weitere dockt daran an.
        </h2>
        <p class="lead">
          Jede KERNSEITE beginnt beim Unternehmen, nicht bei einem Template. Struktur, Design,
          Inhalte und Technik entstehen so, dass der Auftritt zur tatsächlichen Qualität des
          Betriebs passt. Erst danach kommt alles, was sinnvoll daran andockt.
        </p>
      </div>
      <ProcessBand steps={websiteProcess} ariaLabel="Ablauf eines Website-Projekts" />
    </div>
  </section>

  <!-- LEISTUNGSARCHITEKTUR -->
  <section class="section section--paper">
    <div class="content reveal">
      <div class="section-head">
        <p class="eyebrow">Leistungen</p>
        <h2 class="section-title section-title--wide">Ein Fundament. Sinnvolle Ergänzungen.</h2>
        <p class="lead">
          Wir bauen nicht alles an, was möglich ist – sondern das, was bei dir tatsächlich etwas
          bringt.
        </p>
      </div>

      {
        coreService && (
          <div class="services__core">
            <ServiceCard service={coreService} index={0} />
          </div>
        )
      }

      <ul class="services__grid" role="list">
        {
          addOnServices.map((service, i) => (
            <li>
              <ServiceCard service={service} index={i + 1} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ARBEITEN -->
  <section class="section section--sand">
    <div class="content reveal">
      <div class="section-head work__head">
        <p class="eyebrow">Ausgewählte Arbeiten</p>
        <h2 class="section-title">Zwei Betriebe. Zwei Handschriften.</h2>
        <p class="lead">
          Echte, umgesetzte Kundenprojekte aus unterschiedlichen Branchen – jeweils auf das
          zugeschnitten, was der Betrieb wirklich braucht.
        </p>
      </div>
      <ul class="featured" role="list">
        {
          featuredProjects.map((project) => (
            <li class="featured__item">
              <a class="featured__link" href={project.href}>
                <ReferenceImage
                  shot={project.screenshotDesktop}
                  variant="desktop"
                  pending={!project.verified}
                />
                <div class="featured__meta">
                  <p class="featured__cat">{project.category}</p>
                  <h3 class="featured__title">{project.title}</h3>
                  <p class="featured__tagline">{project.tagline}</p>
                  <span class="featured__cta">
                    Projekt ansehen{' '}
                    <span class="arrow" aria-hidden="true">
                      →
                    </span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="work__more">
        <a class="arrow-link" href="/arbeiten/">
          Alle Arbeiten & Konzeptstudien <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- LOKALE SICHTBARKEIT / GOOGLE-UNTERNEHMENSPROFIL -->
  <GoogleProfile />

  <!-- BRANCHEN -->
  <section class="section section--paper">
    <div class="content reveal">
      <div class="section-head">
        <p class="eyebrow">Branchen</p>
        <h2 class="section-title">Gute Gestaltung versteht das Geschäft dahinter.</h2>
      </div>
      <IndustryList />
    </div>
  </section>

  <!-- PROZESS -->
  <section class="section section--bright">
    <div class="content reveal">
      <div class="section-head prozess__head">
        <p class="eyebrow">Prozess</p>
        <h2 class="section-title">Klarer Ablauf. Keine Agentur-Nebelmaschine.</h2>
        <p class="lead">
          Du weißt jederzeit, woran gerade gearbeitet wird, was von dir gebraucht wird und was als
          Nächstes passiert.
        </p>
      </div>
      <ol class="prozess__grid" role="list">
        {
          processShort.map((step, i) => (
            <li class="prozess__step">
              <span class="prozess__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="prozess__title">{step.title}</h3>
              <p class="prozess__body">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="work__more">
        <a class="arrow-link" href="/prozess/">
          Prozess im Detail <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </section>

  <!-- NETZWERK -->
  <section class="section section--sand">
    <div class="content netzwerk reveal">
      <div>
        <p class="eyebrow">Netzwerk</p>
        <h2 class="section-title">Ein Ansprechpartner. Die richtigen Spezialisten.</h2>
      </div>
      <div class="netzwerk__text">
        <p class="lead">
          KERNSEITE wird von Eliyah Korb geführt. Für Film, Social Media und KI arbeiten wir
          projektbezogen mit spezialisierten selbstständigen Partnern zusammen. So bleibt die
          Kommunikation zentral, während jede Aufgabe von der passenden Fachperson umgesetzt wird.
        </p>
        <a class="arrow-link" href="/agentur/">
          Mehr über das Studio <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ-AUSZUG -->
  <section class="section section--paper">
    <div class="content faq-home reveal">
      <div class="faq-home__head">
        <p class="eyebrow">Häufige Fragen</p>
        <h2 class="section-title">Kurz und ehrlich beantwortet.</h2>
        <p class="lead">
          Weitere Antworten – von Kosten bis Datenschutz – findest du auf der FAQ-Seite.
        </p>
        <a class="arrow-link" href="/faq/">
          Alle Fragen ansehen <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="faq-home__list">
        <FaqAccordion items={homeFaqs} />
      </div>
    </div>
  </section>

  <!-- ABSCHLUSS-CTA -->
  <CtaBanner
    title="Zeit für einen Auftritt, der zu deinem Unternehmen passt."
    text="Im ersten Gespräch klären wir, was wirklich sinnvoll ist – und was du dir sparen kannst."
    ctaLabel="Kostenfreie Analyse"
    ctaHref="/kontakt/"
    secondaryLabel="Leistungen ansehen"
    secondaryHref="/leistungen/"
  />
</BaseLayout>

<style>
  /* PROBLEM */
  .problem {
    display: grid;
    gap: var(--space-2xl);
  }
  .problem__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: prob;
    border-block-start: 1px solid var(--border);
  }
  .problem__item {
    counter-increment: prob;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: clamp(1.1rem, 0.8rem + 0.8vw, 1.6rem);
    border-block-end: 1px solid var(--border);
    font-family: var(--font-display);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
  }
  .problem__item::before {
    content: counter(prob, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: var(--fw-regular);
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  @media (min-width: 64rem) {
    .problem {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-4xl);
      align-items: start;
    }
  }

  /* KERN */
  .kern__head .lead {
    max-width: 54ch;
  }

  /* SERVICES */
  .services__core {
    margin-block-end: var(--grid-gap);
  }
  .services__grid {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* WORK */
  .work__more {
    margin-block-start: var(--space-3xl);
  }
  .featured {
    display: grid;
    gap: var(--space-3xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured__link {
    display: block;
    text-decoration: none;
    color: var(--text);
  }
  .featured__link :global(.refimg__screen) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .featured__link:hover :global(.refimg__screen) {
    transform: translateY(-4px);
  }
  .featured__meta {
    margin-block-start: var(--space-xl);
  }
  .featured__cat {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .featured__title {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-h3);
    max-width: 20ch;
  }
  .featured__tagline {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
    max-width: 48ch;
  }
  .featured__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    border-block-end: 1px solid var(--border-strong);
    padding-block-end: 0.3rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .featured__cta .arrow {
    color: var(--brand);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .featured__link:hover .featured__cta {
    border-block-end-color: var(--accent);
  }
  .featured__link:hover .featured__cta .arrow {
    transform: translateX(4px);
  }
  @media (min-width: 48rem) {
    .featured {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--grid-gap);
    }
  }

  /* NETZWERK */
  .netzwerk {
    display: grid;
    gap: var(--space-xl);
  }
  .netzwerk__text {
    display: grid;
    gap: var(--space-xl);
    justify-items: start;
    max-width: 58ch;
  }
  @media (min-width: 64rem) {
    .netzwerk {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-4xl);
      align-items: start;
    }
  }

  /* PROZESS */
  .prozess__grid {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }
  .prozess__step {
    padding-block: var(--space-xl);
    border-block-end: 1px solid var(--border);
  }
  .prozess__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .prozess__title {
    margin-block: var(--space-sm) var(--space-sm);
    font-size: var(--fs-h4);
  }
  .prozess__body {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 46ch;
  }
  @media (min-width: 48rem) {
    .prozess__grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-gap);
    }
  }

  /* FAQ HOME */
  .faq-home {
    display: grid;
    gap: var(--space-2xl);
    align-items: start;
  }
  .faq-home__head {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }
  @media (min-width: 64rem) {
    .faq-home {
      grid-template-columns: 0.8fr 1.2fr;
      gap: var(--space-4xl);
    }
    .faq-home__head {
      position: sticky;
      top: 7rem;
    }
  }
</style>
