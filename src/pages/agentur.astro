---
import PageLayout from '../layouts/PageLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { site } from '../config/site';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Agentur', path: '/agentur/' },
];

const values = [
  {
    title: 'Individuelle Entwicklung',
    body: 'Jede Website beginnt beim Unternehmen, nicht beim Template. Struktur, Design und Technik werden für dich entwickelt.',
  },
  {
    title: 'Ehrliche Beratung',
    body: 'Wir empfehlen, was sinnvoll ist – und sagen auch, was du dir sparen kannst. Keine Paket-Verkäufe.',
  },
  {
    title: 'Keine unnötigen Leistungen',
    body: 'Die Website ist der Kern. Erweiterungen kommen dazu, wenn sie einen echten Zweck erfüllen.',
  },
  {
    title: 'Direkte Kommunikation',
    body: 'Ein fester Ansprechpartner über das ganze Projekt. Kurze Wege, klare Absprachen.',
  },
];

// Rollen neutral dargestellt (keine erfundenen Partnernamen/Lebensläufe).
const roles = [
  {
    role: 'Strategie & Konzeption',
    who: 'Eliyah Korb',
    note: 'Ziele, Seitenstruktur, Inhalte und Projektsteuerung.',
  },
  {
    role: 'Webdesign & Entwicklung',
    who: 'Eliyah Korb',
    note: 'Design, technische Umsetzung, Performance und Barrierearmut.',
  },
  {
    role: 'Unternehmensvideo',
    who: 'Spezialisierter Videopartner',
    note: 'Filmische Umsetzung nach gemeinsamem Konzept.',
  },
  {
    role: 'Social Media',
    who: 'Spezialisierte Partnerin bzw. Partner',
    note: 'Laufende Betreuung und Content-Produktion.',
  },
  {
    role: 'KI & Automatisierung',
    who: 'Spezialisierter KI-Partner',
    note: 'Anspruchsvolle Integrationen und Automatisierungen.',
  },
];
---

<PageLayout
  title="Agentur"
  description="KERNSEITE ist das Digitalstudio von Eliyah Korb aus Würzburg: Schwerpunkt individuelle Websites, ergänzt durch ein projektbezogenes Partnernetzwerk."
  eyebrow="Agentur"
  h1="Klein im Kern. Stark im Netzwerk."
  lead="KERNSEITE ist das Digitalstudio von Eliyah Korb. Der Schwerpunkt liegt auf individuellen Websites und digitalen Auftritten – regional verankert in Würzburg, ergänzt durch ein projektbezogenes Partnernetzwerk."
  breadcrumbs={breadcrumbs}
>
  <!-- Person / Porträt -->
  <section class="section section--paper section--tight">
    <div class="content person">
      <figure class="person__portrait">
        <img
          src="/assets/team/eliyah-portrait.svg"
          width="800"
          height="1000"
          alt="Platzhalter für ein Porträt von Eliyah Korb – echtes Foto folgt."
          loading="lazy"
          decoding="async"
        />
        <figcaption class="person__cap">Porträt folgt</figcaption>
      </figure>
      <div class="person__text">
        <p class="eyebrow">Hinter KERNSEITE</p>
        <h2 class="section-title">Eliyah Korb – dein Ansprechpartner.</h2>
        <p class="lead">
          KERNSEITE wird von Eliyah Korb geführt. Du hast über das ganze Projekt hinweg einen festen
          Ansprechpartner – von der Strategie bis zur fertigen Website.
        </p>
      </div>
    </div>
  </section>

  <!-- Werte -->
  <section class="section section--bright">
    <div class="content">
      <div class="band-head">
        <p class="eyebrow">Haltung</p>
        <h2 class="section-title">Wie wir arbeiten.</h2>
      </div>
      <ul class="values" role="list">
        {
          values.map((v) => (
            <li class="values__item">
              <h3 class="values__title">{v.title}</h3>
              <p class="values__body">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Wer arbeitet an meinem Projekt? -->
  <section class="section section--paper">
    <div class="content">
      <div class="band-head">
        <p class="eyebrow">Transparenz</p>
        <h2 class="section-title section-title--wide">Wer arbeitet an meinem Projekt?</h2>
        <p class="lead measure">
          Eliyah Korb ist dein zentraler Ansprechpartner und verantwortet Strategie, Design,
          Konzeption und Umsetzung. Für Film, Social Media und KI werden je nach Projekt
          spezialisierte selbstständige Partner eingebunden. So bleibt die Kommunikation zentral,
          während jede Aufgabe von der passenden Fachperson übernommen wird.
        </p>
      </div>
      <ul class="roles" role="list">
        {
          roles.map((r) => (
            <li class="roles__item">
              <span class="roles__role">{r.role}</span>
              <span class="roles__who">{r.who}</span>
              <span class="roles__note">{r.note}</span>
            </li>
          ))
        }
      </ul>
      <p class="roles__hint">
        Partnerprofile mit Namen und Bild veröffentlichen wir nur nach ausdrücklicher Freigabe. Bis
        dahin stellen wir die Rollen neutral dar.
      </p>
    </div>
  </section>

  <!-- Region -->
  <section class="section section--muted">
    <div class="content region">
      <div>
        <p class="eyebrow">Region</p>
        <h2 class="section-title">Verwurzelt in {site.region.city}.</h2>
      </div>
      <p class="lead region__text">
        KERNSEITE arbeitet aus {site.region.city} in {site.region.area} und betreut Unternehmen in {
          site.region.state
        } und darüber hinaus. Persönliche Termine in der Region sind möglich; vieles lässt sich zugleich
        unkompliziert digital abstimmen.
      </p>
    </div>
  </section>

  <CtaBanner
    title="Lernen wir uns kennen."
    text="Ein erstes Gespräch ist unverbindlich – und oft klärt es schon eine Menge."
    ctaLabel="Projekt besprechen"
    ctaHref="/kontakt/"
    secondaryLabel="Prozess ansehen"
    secondaryHref="/prozess/"
  />
</PageLayout>

<style>
  .band-head {
    display: grid;
    gap: var(--space-sm);
    margin-block-end: var(--space-xl);
  }

  .person {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .person__portrait {
    margin: 0;
    position: relative;
    max-width: 340px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  .person__portrait img {
    display: block;
    width: 100%;
    height: auto;
  }
  .person__cap {
    position: absolute;
    inset-block-end: 0.6rem;
    inset-inline-start: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-alert);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
  }
  @media (min-width: 48rem) {
    .person {
      grid-template-columns: auto 1fr;
      gap: var(--space-4xl);
    }
  }
  .values {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .values__item {
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--color-bright);
  }
  .values__title {
    font-size: var(--fs-h4);
  }
  .values__body {
    margin-block-start: 0.4rem;
    color: var(--text-muted);
  }

  .roles {
    display: grid;
    gap: 0;
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }
  .roles__item {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 1.1rem 0;
    border-block-end: 1px solid var(--border);
  }
  .roles__role {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h4);
  }
  .roles__who {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--brand-strong);
  }
  .roles__note {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .roles__hint {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 64ch;
  }

  .region__text {
    max-width: 62ch;
  }

  @media (min-width: 48rem) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .roles__item {
      grid-template-columns: 1fr 1fr 1.4fr;
      align-items: baseline;
    }
    .region {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      align-items: start;
    }
  }
</style>
