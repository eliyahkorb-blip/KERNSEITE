---
import PageLayout from '../layouts/PageLayout.astro';
import { site } from '../config/site';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Cookie-Einstellungen', path: '/cookie-einstellungen/' },
];
---

<PageLayout
  title="Cookie-Einstellungen"
  description="Cookie- und Einwilligungseinstellungen."
  h1="Cookie-Einstellungen"
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <section class="section section--paper">
    <div class="content prose">
      {
        site.consentRequired ? (
          <>
            <p>
              Hier kannst du deine Einwilligung zu optionalen Diensten anpassen. Notwendige
              Funktionen sind für den Betrieb der Website erforderlich und immer aktiv.
            </p>
            <p>
              <button type="button" class="btn btn--secondary" data-consent-reset>
                Auswahl zurücksetzen
              </button>
            </p>
            <p class="cookie-reset-status" role="status" aria-live="polite" data-reset-status />
          </>
        ) : (
          <>
            <p>
              Aktuell setzt diese Website ausschließlich technisch notwendige Funktionen ein. Es
              werden keine zustimmungspflichtigen Cookies oder Tracking-Dienste verwendet – daher
              ist keine Cookie-Einwilligung erforderlich.
            </p>
            <p>
              Sollten wir künftig einwilligungspflichtige Dienste einbinden, findest du an dieser
              Stelle die Möglichkeit, deine Einwilligung zu verwalten und jederzeit zu widerrufen.
              Weitere Informationen findest du in der{' '}
              <a href="/datenschutz/">Datenschutzerklärung</a>.
            </p>
          </>
        )
      }
    </div>
  </section>
</PageLayout>

<script>
  // Auf oberster Ebene statt in einem JSX-Ausdruck: Ein `<script>` innerhalb
  // eines Ausdrucks kann Prettier nicht parsen. Der Code prüft selbst, ob die
  // Schaltfläche existiert – ohne Einwilligungspflicht passiert nichts.
  const resetBtn = document.querySelector('[data-consent-reset]');
  const resetStatus = document.querySelector('[data-reset-status]');

  resetBtn?.addEventListener('click', () => {
    localStorage.removeItem('kernseite-consent');
    if (resetStatus) {
      resetStatus.textContent =
        'Deine Auswahl wurde zurückgesetzt. Beim nächsten Seitenaufruf wirst du erneut gefragt.';
    }
  });
</script>
