---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
// Nach global.css: veredelt gezielt die vorhandenen `.btn`-Flächen.
import '../styles/button-metal.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentManager from '../components/ConsentManager.astro';
import AccessibilityDock from '../components/AccessibilityDock.astro';
import { site } from '../config/site';
import { websiteJsonLd, organizationJsonLd } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Array<Record<string, unknown> | null>;
  bodyClass?: string;
}

const { title, description, ogImage, noindex = false, jsonLd = [], bodyClass } = Astro.props;
const path = Astro.url.pathname;

// Basis-Schemas auf jeder Seite (Organization nur bei vollständigen Echtdaten).
const baseSchemas = [websiteJsonLd(), organizationJsonLd()];
const allSchemas = [...baseSchemas, ...jsonLd];
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ede9e1" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#101214" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Kritische, lokal gehostete Schriften vorladen -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/bricolage-grotesque-latin-var.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-latin-400.woff2"
      crossorigin
    />

    <!-- Gespeicherte Darstellungseinstellungen vor dem ersten Paint anwenden.
         Externe Datei, damit die CSP ohne 'unsafe-inline' auskommt. -->
    <script src="/a11y-init.js" is:inline></script>

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={allSchemas}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentManager />
    <AccessibilityDock />

    <script>
      // Sehr dezentes Reveal beim Scrollen. Ohne JS bleibt alles sichtbar,
      // bei `prefers-reduced-motion` wird gar nicht erst ausgeblendet.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!reduced && targets.length && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('has-reveal');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
