---
/**
 * GoogleProfile – Sektion „Lokale Sichtbarkeit“.
 *
 * Zeigt den echten Screenshot des Google-Unternehmensprofils von
 * Anna-Lena’s Kinderkörbchen. Der Screenshot wird unverändert eingebunden:
 * keine nachgezeichnete Darstellung, keine veränderten Zahlen, keine
 * erfundenen Bewertungen.
 */
import AccentWord from './AccentWord.astro';

interface Props {
  /** Auf Unterseiten ohne eigenen Abschnittsrahmen einsetzbar. */
  bare?: boolean;
}
const { bare = false } = Astro.props;

const points = [
  {
    title: 'Profil sauber aufsetzen',
    body: 'Kategorien, Öffnungszeiten, Kontaktwege und Fotos vollständig und korrekt hinterlegen – statt halb ausgefüllt zu bleiben.',
  },
  {
    title: 'Leistungen eindeutig darstellen',
    body: 'Was ihr anbietet, steht als Leistung im Profil. So findet Google die Antwort auf eine konkrete Suche.',
  },
  {
    title: 'Website und Profil verbinden',
    body: 'Beide sagen dasselbe: gleiche Angaben, gleiche Sprache, passende Landeseiten statt Startseiten-Link für alles.',
  },
  {
    title: 'Bewertungen professionell begleiten',
    body: 'Ein Ablauf für Anfragen um Bewertungen und für Antworten – sachlich, zeitnah, ohne gekaufte Sterne.',
  },
];
---

<section class:list={['gbp', bare ? 'gbp--bare' : 'section section--paper']}>
  <div class="content gbp__inner">
    <figure class="gbp__shot">
      <img
        src="/assets/references/google-business-profile-kinderkoerbchen.webp"
        width="455"
        height="569"
        alt="Google-Unternehmensprofil von Anna-Lena’s Kinderkörbchen mit Adresse, Öffnungszeiten, Telefonnummer und Bewertungen."
        loading="lazy"
        decoding="async"
      />
      <figcaption class="gbp__cap">Echtes Unternehmensprofil eines KERNSEITE-Projekts</figcaption>
    </figure>

    <div class="gbp__text">
      <h2 class="gbp__title">
        Gefunden werden, wenn es <AccentWord>vor Ort</AccentWord> zählt.
      </h2>
      <p class="lead gbp__lead">
        Viele Anfragen entstehen nicht auf der Website, sondern direkt in der Google-Suche und in
        Maps. Wir richten das Profil ein, pflegen es und stimmen es auf die Website ab.
      </p>

      <ul class="gbp__points" role="list">
        {
          points.map((p) => (
            <li class="gbp__point">
              <h3 class="gbp__point-title">{p.title}</h3>
              <p class="gbp__point-body">{p.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="gbp__cta">
        <a class="link-arrow" href="/leistungen/google-unternehmensprofil/">
          Google-Unternehmensprofil ansehen <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
      <p class="gbp__note">
        Sichtbarkeit lässt sich verbessern, aber nicht garantieren. Wir arbeiten an dem, was in
        deiner Hand liegt – und nennen keine Platzierungen als Versprechen.
      </p>
    </div>
  </div>
</section>

<style>
  .gbp__inner {
    display: grid;
    gap: clamp(2.5rem, 2rem + 4vw, 5rem);
    align-items: start;
  }

  .gbp__shot {
    margin: 0;
    justify-self: start;
    max-inline-size: 26rem;
  }
  .gbp__shot img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border: 1px solid var(--line);
  }
  .gbp__cap {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .gbp__title {
    font-size: var(--fs-h2);
    max-width: 15ch;
  }
  .gbp__lead {
    margin-block-start: var(--space-xl);
  }

  .gbp__points {
    margin-block-start: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: 0;
    list-style: none;
    display: grid;
    border-block-start: 1px solid var(--line);
  }
  .gbp__point {
    padding-block: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border-block-end: 1px solid var(--line);
  }
  .gbp__point-title {
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    letter-spacing: -0.02em;
  }
  .gbp__point-body {
    margin-block-start: 0.4rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 52ch;
  }

  .gbp__cta {
    margin-block-start: var(--space-2xl);
  }
  .gbp__note {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 54ch;
  }

  @media (min-width: 64rem) {
    .gbp__inner {
      grid-template-columns: 0.72fr 1.28fr;
      gap: clamp(3rem, 5vw, 6rem);
    }
    .gbp__shot {
      position: sticky;
      top: 7rem;
      max-inline-size: none;
    }
  }
</style>
