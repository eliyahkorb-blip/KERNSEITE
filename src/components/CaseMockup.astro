---
// Lokal erzeugtes, eigenständiges UI-Mockup für Konzeptstudien (kein Fremd-Screenshot).
interface Props {
  theme: 'meisterwerk' | 'dentale-linie' | 'haus-am-fluss';
  brand: string;
  tagline: string;
  industryLabel: string;
  class?: string;
}
const { theme, brand, tagline, industryLabel, class: className } = Astro.props;
---

<div
  class={`case-mockup case-mockup--${theme} ${className ?? ''}`}
  data-theme={theme}
  aria-hidden="true"
>
  <div class="case-mockup__chrome">
    <span class="case-mockup__dots"><i></i><i></i><i></i></span>
  </div>
  <div class="case-mockup__body">
    <div class="case-mockup__nav">
      <span class="case-mockup__brand">{brand}</span>
      <span class="case-mockup__links"><i></i><i></i><i></i></span>
    </div>
    <p class="case-mockup__eyebrow">{industryLabel}</p>
    <p class="case-mockup__headline">{tagline}</p>
    <span class="case-mockup__cta"></span>
    <div class="case-mockup__rows">
      <span></span><span></span><span class="is-short"></span>
    </div>
  </div>
</div>

<style>
  .case-mockup {
    --m-accent: var(--color-ultramarine);
    --m-bg: var(--color-bright);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--m-bg);
    box-shadow: var(--shadow-sm);
    width: 100%;
  }
  .case-mockup--dentale-linie {
    --m-accent: #0a8ea0;
  }
  .case-mockup--haus-am-fluss {
    --m-accent: var(--color-navy);
    --m-bg: #f7f5ee;
  }
  .case-mockup__chrome {
    padding: 0.45rem 0.6rem;
    background: var(--surface-muted);
    border-block-end: 1px solid var(--border);
  }
  .case-mockup__dots {
    display: inline-flex;
    gap: 4px;
  }
  .case-mockup__dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .case-mockup__body {
    padding: clamp(0.75rem, 2vw, 1.4rem);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .case-mockup__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .case-mockup__brand {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--m-accent);
    font-size: clamp(0.8rem, 1.4vw, 1.05rem);
  }
  .case-mockup__links {
    display: inline-flex;
    gap: 5px;
  }
  .case-mockup__links i {
    width: 16px;
    height: 5px;
    border-radius: 3px;
    background: var(--border-strong);
  }
  .case-mockup__eyebrow {
    margin-block-start: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .case-mockup__headline {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.05;
    font-size: clamp(1.1rem, 2.6vw, 1.8rem);
    color: var(--text);
    max-width: 16ch;
  }
  .case-mockup__cta {
    width: 42%;
    height: 10px;
    border-radius: 999px;
    background: var(--m-accent);
    margin-block-start: 0.3rem;
  }
  .case-mockup__rows {
    margin-block-start: 0.6rem;
    display: grid;
    gap: 6px;
  }
  .case-mockup__rows span {
    height: 8px;
    border-radius: 4px;
    background: var(--surface-muted);
  }
  .case-mockup__rows span.is-short {
    width: 55%;
  }
</style>
