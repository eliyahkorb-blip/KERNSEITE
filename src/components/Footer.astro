---
import { footerNav } from '../config/navigation';
import { site, canShowHostingClaim } from '../config/site';
import { activeCompany } from '../lib/config-validation';
const year = new Date().getFullYear();
const c = activeCompany;
const legal = footerNav.find((group) => group.title === 'Rechtliches');
const groups = footerNav.filter((group) => group !== legal);
---

<footer class="ft section--dark on-dark">
  <div class="content">
    <div class="ft__top">
      <div>
        <a class="ft__wordmark" href="/" aria-label="KERNSEITE – zur Startseite"
          >KERNSEITE<span aria-hidden="true">.</span></a
        >
        <p class="ft__region">{site.region.claim}</p>
      </div>
      <div class="ft__contact">
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <a href={`tel:${c.phone.replace(/[^+\d]/g, '')}`}>{c.phone}</a>
        <a class="btn btn--primary" href="/kontakt/">Website anfragen</a>
      </div>
    </div>
    <nav class="ft__nav" aria-label="Footer-Navigation">
      {
        groups.map((group) => (
          <div class="ft__group">
            <h2 class="ft__label">{group.title}</h2>
            <ul role="list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <div class="ft__bottom">
      <p class="ft__copy">{`© ${year} ${c.legalDisplayName} · ${c.city}, ${site.region.state}`}</p>
      <ul class="ft__meta" role="list">
        {
          legal?.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        {
          site.consentRequired && (
            <li>
              <a href="/cookie-einstellungen/">Cookie-Einstellungen</a>
            </li>
          )
        }
      </ul>
      {canShowHostingClaim && <p class="ft__copy">{site.hostingClaimText}</p>}
    </div>
  </div>
</footer>
<style>
  .ft {
    padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
  }
  .ft__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem 3rem;
    margin-block-end: 2.5rem;
  }
  .ft a.ft__wordmark {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--text-invert);
    text-decoration: none;
  }
  .ft__wordmark span {
    color: var(--ks-cyan);
  }
  .ft__region {
    margin-block-start: 0.5rem;
    color: var(--text-invert-muted);
    font-size: 0.9375rem;
  }
  .ft__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .ft__contact > a:not(.btn) {
    color: var(--text-invert);
    text-decoration: none;
    font-size: 1rem;
  }
  .ft__nav {
    display: grid;
    gap: 1.5rem;
  }
  .ft__group {
    display: grid;
    gap: 0.65rem 1.5rem;
  }
  .ft__label {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-invert);
    letter-spacing: 0;
  }
  .ft__group ul,
  .ft__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
  }
  .ft__group a,
  .ft__meta a {
    display: inline-block;
    color: var(--text-invert-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    padding-block: 0.25rem;
  }
  .ft__group a:hover,
  .ft__meta a:hover,
  .ft__contact > a:not(.btn):hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .ft__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    border-block-start: 1px solid var(--line-invert);
    margin-block-start: 2rem;
    padding-block-start: 1.5rem;
  }
  .ft__copy {
    font-size: 0.9375rem;
    color: var(--text-invert-muted);
  }
  @media (min-width: 48rem) {
    .ft__group {
      grid-template-columns: 8rem minmax(0, 1fr);
    }
  }
  @media (max-width: 20rem) {
    .ft__group a,
    .ft__meta a {
      white-space: normal;
    }
  }
</style>
