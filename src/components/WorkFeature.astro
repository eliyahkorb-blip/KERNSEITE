---
/**
 * WorkFeature – großflächige Inszenierung eines echten Projekts.
 * Keine Karte, keine Box: großer Screenshot, große Headline, feine Linien.
 * Die Ausrichtung wechselt je Projekt (`flip`), damit keine Reihe entsteht.
 */
import type { ProjectWork } from '../config/cases';

interface Props {
  work: ProjectWork;
  index: number;
  /** true = Text links, Bild rechts. */
  flip?: boolean;
  /** Dunkle Bühne (passend zu Projekten mit dunklem Kopfbereich). */
  tone?: 'light' | 'dark';
}
const { work, index, flip = false, tone = 'light' } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class:list={['wf', { 'wf--flip': flip, 'wf--dark': tone === 'dark' }]}>
  <div class="wf__inner content--wide content">
    <div class="wf__media">
      <div class="wf__media-link">
        <img
          src={work.screenshotDesktop.src}
          srcset={work.screenshotDesktop.srcset}
          sizes="(min-width: 64rem) 62vw, 100vw"
          width={work.screenshotDesktop.width}
          height={work.screenshotDesktop.height}
          alt={work.screenshotDesktop.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="wf__text">
      <p class="wf__meta">
        <span class="chapter-num">{num}</span>
        <span class="wf__cat">{work.category}</span>
      </p>
      <h2 class="wf__title">
        <a class="wf__link" href={work.href}>{work.headline}</a>
      </h2>
      <p class="wf__client">{work.title}</p>
      <p class="wf__body">{work.tagline}</p>
      <div class="wf__actions">
        <a class="link-arrow" href={work.href}>
          Projekt ansehen <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="wf__live" href={work.liveUrl} target="_blank" rel="noopener noreferrer">
          {work.liveLabel}
          <span class="visually-hidden"> (öffnet in neuem Tab)</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .wf {
    padding-block: clamp(3rem, 2rem + 5vw, 7rem);
    background: var(--ks-cream);
  }
  .wf--dark {
    background: var(--ks-black);
    color: var(--text-invert);
  }

  .wf__inner {
    display: grid;
    gap: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }

  .wf__media {
    position: relative;
    overflow: hidden;
    background: var(--ks-surface);
  }
  .wf__media img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .wf:hover .wf__media img {
    transform: scale(1.015);
  }
  .wf--dark .wf__media {
    background: var(--ks-black-soft);
  }

  .wf__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wf__cat {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .wf--dark .wf__cat {
    color: var(--text-muted);
  }

  .wf__title {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-h3);
    line-height: 0.94;
    letter-spacing: var(--track-display);
    max-width: 14ch;
    color: var(--text);
  }
  /* Auf der dunklen Bühne muss die Überschrift hell sein. */
  .wf--dark .wf__title {
    color: var(--text-invert);
  }
  .wf__link {
    color: inherit;
    text-decoration: none;
  }
  .wf__link:hover {
    color: inherit;
  }
  /* Ganze Fläche klickbar, ohne den Screenshot doppelt zu verlinken */
  .wf__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .wf__inner {
    position: relative;
  }

  .wf__client {
    margin-block-start: var(--space-md);
    font-weight: var(--fw-semibold);
  }
  .wf__body {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
    max-width: 44ch;
  }
  .wf--dark .wf__body {
    color: var(--text-muted);
  }

  .wf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
    margin-block-start: var(--space-xl);
  }
  .wf__live {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--accent-ink);
    text-underline-offset: 0.25em;
  }
  .wf--dark .wf__live {
    color: var(--accent);
  }

  @media (min-width: 64rem) {
    .wf__inner {
      grid-template-columns: 1.55fr 1fr;
      gap: clamp(2.5rem, 4vw, 5rem);
    }
    .wf--flip .wf__media {
      order: 2;
    }
    .wf--flip .wf__text {
      order: 1;
    }
    .wf--flip .wf__inner {
      grid-template-columns: 1fr 1.55fr;
    }
  }
</style>
