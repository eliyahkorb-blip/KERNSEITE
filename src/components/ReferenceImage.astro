---
import type { WorkScreenshot } from '../config/cases';

interface Props {
  shot: WorkScreenshot;
  variant?: 'desktop' | 'phone';
  /** Above-the-fold -> eager laden; sonst lazy. */
  eager?: boolean;
  /** Kennzeichnung anzeigen, solange kein finaler Screenshot vorliegt. */
  pending?: boolean;
  class?: string;
}

const { shot, variant = 'desktop', eager = false, pending = true, class: className } = Astro.props;
---

<figure class={`refimg refimg--${variant} ${className ?? ''}`}>
  <div class="refimg__screen">
    <img
      src={shot.src}
      width={shot.width}
      height={shot.height}
      alt={shot.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  {
    pending && (
      <figcaption class="refimg__note">Gestaltungsvorschau – finaler Screenshot folgt</figcaption>
    )
  }
</figure>

<style>
  .refimg {
    margin: 0;
  }
  .refimg__screen {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--color-bright);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .refimg--phone .refimg__screen {
    border-radius: 24px;
    max-width: 300px;
    border: 6px solid var(--color-ink);
  }
  .refimg__screen img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-paper);
  }
  .refimg__note {
    margin-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .section--dark .refimg__note {
    color: var(--text-invert-muted);
  }
</style>
