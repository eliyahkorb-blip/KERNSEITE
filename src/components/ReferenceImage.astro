---
import type { WorkScreenshot } from '../config/cases';

interface Props {
  shot: WorkScreenshot;
  variant?: 'desktop' | 'phone';
  /** Above-the-fold -> eager laden; sonst lazy. */
  eager?: boolean;
  /** Platzhalter-Kennzeichnung anzeigen (bis echter Screenshot vorliegt). */
  pending?: boolean;
  class?: string;
}

const { shot, variant = 'desktop', eager = false, pending = true, class: className } = Astro.props;
---

<figure class={`refimg refimg--${variant} ${className ?? ''}`}>
  {
    variant === 'desktop' && (
      <div class="refimg__chrome" aria-hidden="true">
        <span class="refimg__dots">
          <i />
          <i />
          <i />
        </span>
      </div>
    )
  }
  <div class="refimg__screen">
    <img
      src={shot.src}
      width={shot.width}
      height={shot.height}
      alt={shot.alt}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    {pending && <span class="refimg__tag">Screenshot folgt</span>}
  </div>
</figure>

<style>
  .refimg {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--color-bright);
    box-shadow: var(--shadow-md);
  }
  .refimg--phone {
    border-radius: 28px;
    max-width: 320px;
    border-width: 8px;
    border-color: var(--color-graphite);
  }
  .refimg__chrome {
    display: flex;
    align-items: center;
    padding: 0.55rem 0.8rem;
    background: var(--surface-muted);
    border-block-end: 1px solid var(--border);
  }
  .refimg__dots {
    display: inline-flex;
    gap: 5px;
  }
  .refimg__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .refimg__screen {
    position: relative;
  }
  .refimg__screen img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-paper);
  }
  .refimg__tag {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-end: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #fff;
    background: var(--color-alert);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
  }
</style>
