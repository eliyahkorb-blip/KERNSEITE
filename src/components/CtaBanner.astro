---
/**
 * CtaBanner – vollbreite Abschluss-Sektion in KERNSEITE-Cyan.
 * Kein Kasten, kein Rahmen: die Fläche selbst ist der Handlungsaufruf.
 */
import { activeCompany } from '../lib/config-validation';

interface Props {
  title?: string;
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Zweite Zeile: standardmäßig die E-Mail-Adresse. */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const c = activeCompany;
const {
  title,
  text = 'Erzähl kurz, was du vorhast. Im ersten Gespräch klären wir, was sich lohnt – und was du dir sparen kannst.',
  ctaLabel = 'Projekt besprechen',
  ctaHref = '/kontakt/',
  secondaryLabel = c.email,
  secondaryHref = `mailto:${c.email}`,
} = Astro.props;
---

<section class="cta section--cyan">
  <div class="content cta__inner">
    <h2 class="cta__title">
      {
        title ? (
          title
        ) : (
          <>
            Dein Unternehmen ist bereit.
            <br />
            Ist deine <em class="cta__mark">Website</em> es auch?
          </>
        )
      }
    </h2>
    <p class="cta__text">{text}</p>
    <div class="cta__actions">
      <a class="btn btn--primary" href={ctaHref}>{ctaLabel}</a>
      {
        secondaryLabel && secondaryHref && (
          <a class="cta__mailto" href={secondaryHref}>
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(4.5rem, 3rem + 8vw, 10rem);
  }
  .cta__inner {
    display: grid;
    gap: var(--space-xl);
  }
  .cta__title {
    font-size: var(--fs-h2);
    line-height: 0.9;
    letter-spacing: var(--track-display);
    max-width: 18ch;
  }
  /* Hervorhebung auf der Cyan-Fläche: rein typografisch, keine Fläche */
  .cta__mark {
    font-style: normal;
    background: none;
    color: var(--ks-black);
    text-decoration-line: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.12em;
    white-space: nowrap;
  }
  .cta__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: 46ch;
    color: var(--ks-black);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
    margin-block-start: var(--space-md);
  }
  .cta__mailto {
    font-size: var(--fs-small);
    color: var(--ks-black);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 30rem) {
    .cta__actions .btn {
      inline-size: 100%;
    }
  }
</style>
