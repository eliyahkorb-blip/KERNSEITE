---
interface Props {
  title: string;
  text?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  /** Kleiner, ehrlicher Zusatz unter den Schaltflächen. */
  note?: string;
}
const {
  title,
  text,
  ctaLabel,
  ctaHref,
  secondaryLabel,
  secondaryHref,
  note = 'Antwort in der Regel innerhalb eines Werktags. Kein Verkaufsdruck.',
} = Astro.props;
---

<section class="cta-banner section--dark on-dark">
  <div class="content cta-banner__inner">
    <div class="cta-banner__text">
      <h2 class="cta-banner__title">{title}</h2>
      {text && <p class="lead cta-banner__lead">{text}</p>}
    </div>
    <div class="cta-banner__side">
      <div class="cta-banner__actions">
        <a class="btn btn--primary" href={ctaHref}>{ctaLabel}</a>
        {
          secondaryLabel && secondaryHref && (
            <a class="btn btn--secondary" href={secondaryHref}>
              {secondaryLabel}
            </a>
          )
        }
      </div>
      {note && <p class="cta-banner__note">{note}</p>}
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding-block: var(--section-y);
  }
  .cta-banner__inner {
    display: grid;
    gap: var(--space-2xl);
    align-items: end;
  }
  .cta-banner__title {
    font-size: var(--fs-h1);
    max-width: 18ch;
  }
  .cta-banner__lead {
    margin-block-start: var(--space-lg);
    max-width: 48ch;
  }
  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .cta-banner__note {
    margin-block-start: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-invert-muted);
    max-width: 34ch;
  }
  @media (min-width: 64rem) {
    .cta-banner__inner {
      grid-template-columns: 1.2fr 0.8fr;
      gap: var(--space-4xl);
    }
  }
  @media (max-width: 30rem) {
    .cta-banner__actions .btn {
      width: 100%;
    }
  }
</style>
