---
interface Props {
  title: string;
  text?: string;
  ctaLabel: string;
  ctaHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const { title, text, ctaLabel, ctaHref, secondaryLabel, secondaryHref } = Astro.props;
---

<section class="cta-banner section--navy on-dark">
  <div class="content cta-banner__inner">
    <h2 class="cta-banner__title">{title}</h2>
    {text && <p class="lead cta-banner__text">{text}</p>}
    <div class="cta-banner__actions">
      <a class="btn btn--primary" href={ctaHref}>{ctaLabel}</a>
      {
        secondaryLabel && secondaryHref && (
          <a class="btn btn--secondary" href={secondaryHref}>
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta-banner {
    padding-block: var(--section-y);
  }
  .cta-banner__inner {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }
  .cta-banner__title {
    font-size: var(--fs-h1);
    max-width: 20ch;
  }
  .cta-banner__text {
    max-width: 52ch;
  }
  .cta-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-xs);
  }
</style>
