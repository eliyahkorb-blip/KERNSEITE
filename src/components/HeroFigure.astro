---
/**
 * HeroFigure – CRT-Head-Figur als gezeichnete Hero-Szene.
 *
 * Menschlicher Körper im Anzug, der Kopf ist vollständig durch einen alten
 * Röhrenmonitor ersetzt. Bewusst als ruhige, editoriale Illustration angelegt
 * (kein Foto-Imitat): reduzierte, monochrome Anlage, Cyan ausschließlich auf
 * dem Bildschirm.
 *
 * Bildschirmfläche, Scanlines und Wortwechsel liegen im selben SVG-Koordinaten-
 * system wie der Monitor – dadurch sitzen sie immer exakt aufeinander, auch wenn
 * die Szene formatfüllend skaliert wird.
 *
 * Diese Fassung greift, solange kein finales Video vorliegt. Sobald das Video da
 * ist, ersetzt es die Figur (siehe docs/HERO_VIDEO.md).
 */
interface Props {
  /** Erster angezeigter Begriff auf dem Bildschirm. */
  word: string;
  /** Alle Begriffe, durch `|` getrennt (für den ruhigen Wechsel). */
  words: string;
}
const { word, words } = Astro.props;
---

<svg
  class="figure"
  viewBox="0 0 1920 1080"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="hf-room" x1="0.1" y1="0" x2="0.6" y2="1">
      <stop offset="0" stop-color="#262B31" />
      <stop offset="0.48" stop-color="#191D22" />
      <stop offset="1" stop-color="#0C0E11" />
    </linearGradient>
    <radialGradient id="hf-spill" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#00E3F2" stop-opacity="0.26" />
      <stop offset="0.5" stop-color="#00E3F2" stop-opacity="0.06" />
      <stop offset="1" stop-color="#00E3F2" stop-opacity="0" />
    </radialGradient>

    <!-- Anzug -->
    <linearGradient id="hf-suit" x1="0.05" y1="0" x2="0.95" y2="0.7">
      <stop offset="0" stop-color="#454C55" />
      <stop offset="0.38" stop-color="#2C323A" />
      <stop offset="0.75" stop-color="#1D2127" />
      <stop offset="1" stop-color="#12151A" />
    </linearGradient>
    <linearGradient id="hf-lapel" x1="0" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#525A65" />
      <stop offset="1" stop-color="#232830" />
    </linearGradient>

    <!-- Monitorgehäuse: warmes, gealtertes Beige -->
    <linearGradient id="hf-case" x1="0.1" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#E4DCC9" />
      <stop offset="0.35" stop-color="#CDC3AC" />
      <stop offset="0.72" stop-color="#A69B84" />
      <stop offset="1" stop-color="#7D745F" />
    </linearGradient>
    <linearGradient id="hf-bezel" x1="0.15" y1="0" x2="0.85" y2="1">
      <stop offset="0" stop-color="#DAD1BD" />
      <stop offset="0.6" stop-color="#BCB29B" />
      <stop offset="1" stop-color="#8F8670" />
    </linearGradient>
    <linearGradient id="hf-neck" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#7D745F" />
      <stop offset="0.4" stop-color="#B0A791" />
      <stop offset="1" stop-color="#6E6653" />
    </linearGradient>

    <!-- Bildschirm -->
    <radialGradient id="hf-screen" cx="0.48" cy="0.36" r="0.8">
      <stop offset="0" stop-color="#6FF2FB" />
      <stop offset="0.45" stop-color="#00E3F2" />
      <stop offset="1" stop-color="#048795" />
    </radialGradient>

    <pattern id="hf-scan" width="5" height="5" patternUnits="userSpaceOnUse">
      <rect width="5" height="2" fill="#04333A" opacity="0.18" />
    </pattern>

    <filter id="hf-glow" x="-70%" y="-70%" width="240%" height="240%">
      <feGaussianBlur stdDeviation="30" />
    </filter>
    <filter id="hf-soft" x="-40%" y="-40%" width="180%" height="180%">
      <feGaussianBlur stdDeviation="14" />
    </filter>

    <clipPath id="hf-screen-clip">
      <rect x="1176" y="322" width="268" height="200" rx="26" />
    </clipPath>
  </defs>

  <!-- ================= Raum ================= -->
  <rect width="1920" height="1080" fill="url(#hf-room)" />
  <ellipse class="figure__spill" cx="1310" cy="420" rx="820" ry="660" fill="url(#hf-spill)" />

  <!-- ================= Körper ================= -->
  <g class="figure__body">
    <!-- Sakko: breite, klar lesbare Schultern -->
    <path
      d="M1310 648
         C1246 650 1170 668 1108 700
         C1064 724 1038 762 1028 806
         L1004 1080
         L1616 1080
         L1592 806
         C1582 762 1556 724 1512 700
         C1450 668 1374 650 1310 648 Z"
      fill="url(#hf-suit)"
    />

    <!-- Hemd -->
    <path d="M1310 650 L1386 700 L1310 892 L1234 700 Z" fill="#EDEAE3" />
    <!-- Krawatte -->
    <path d="M1310 706 L1340 738 L1324 900 L1310 926 L1296 900 L1280 738 Z" fill="#15181B" />

    <!-- Revers links/rechts -->
    <path d="M1234 700 L1310 892 L1214 1080 L1122 1080 C1136 908 1176 782 1234 700 Z" fill="url(#hf-lapel)" />
    <path d="M1386 700 L1310 892 L1406 1080 L1498 1080 C1484 908 1444 782 1386 700 Z" fill="url(#hf-lapel)" />

    <!-- Kragenspitzen -->
    <path d="M1310 650 L1234 700 L1262 646 Z" fill="#F6F4EF" />
    <path d="M1310 650 L1386 700 L1358 646 Z" fill="#F6F4EF" />

    <!-- Schulterlicht vom Bildschirm -->
    <path
      d="M1310 648 C1246 650 1170 668 1108 700 C1172 678 1238 668 1310 666 C1382 668 1448 678 1512 700 C1450 668 1374 650 1310 648 Z"
      fill="#00E3F2"
      opacity="0.28"
    />
  </g>

  <!-- ================= Monitor-Kopf ================= -->
  <g class="figure__head">
    <!-- Hals im Schatten (der Monitor sitzt direkt darauf) -->
    <path d="M1274 540 h72 v116 h-72 z" fill="#171B20" />
    <path d="M1274 540 h16 v116 h-16 z" fill="#000000" opacity="0.35" />

    <!-- Schatten hinter dem Gehäuse -->
    <rect x="1112" y="258" width="396" height="320" rx="34" fill="#05070A" opacity="0.65" filter="url(#hf-soft)" />

    <!-- Gehäuse -->
    <rect x="1108" y="242" width="404" height="326" rx="32" fill="url(#hf-case)" />
    <rect x="1108" y="242" width="404" height="9" rx="4.5" fill="#F2ECDD" opacity="0.6" />
    <rect
      x="1108"
      y="242"
      width="404"
      height="326"
      rx="32"
      fill="none"
      stroke="#6B6353"
      stroke-width="2"
      opacity="0.55"
    />

    <!-- Front-Blende -->
    <rect x="1134" y="264" width="352" height="282" rx="26" fill="url(#hf-bezel)" />

    <!-- Bildschirmvertiefung (CRT sitzt tief im Gehäuse) -->
    <rect x="1164" y="310" width="292" height="224" rx="32" fill="#4A4438" />
    <rect x="1170" y="316" width="280" height="212" rx="29" fill="#0E2429" />

    <!-- Bildschirmfläche -->
    <g clip-path="url(#hf-screen-clip)">
      <rect class="figure__screen" x="1176" y="322" width="268" height="200" fill="url(#hf-screen)" />
      <rect class="figure__scan" x="1176" y="316" width="268" height="212" fill="url(#hf-scan)" />
      <!-- weicher Phosphor-Schein, liegt UNTER der Schrift -->
      <ellipse cx="1310" cy="398" rx="150" ry="112" fill="#BFFAFF" opacity="0.28" filter="url(#hf-soft)" />
      <text
        class="figure__word"
        data-hero-word
        data-words={words}
        x="1310"
        y="432"
        text-anchor="middle"
        font-family="'IBM Plex Mono', ui-monospace, monospace"
        font-size="30"
        font-weight="600"
        letter-spacing="5"
        fill="#03303A">{word}</text
      >
      <!-- dezente Glasreflexion -->
      <path d="M1176 322 L1318 322 L1206 522 L1176 522 Z" fill="#FFFFFF" opacity="0.1" />
    </g>

    <!-- Glaskante -->
    <rect
      x="1176"
      y="322"
      width="268"
      height="200"
      rx="26"
      fill="none"
      stroke="#0A4A54"
      stroke-width="2.5"
      opacity="0.5"
    />

    <!-- Kinnbereich: Lüftungsschlitze, Laufwerk, Betriebsanzeige -->
    <g fill="#7E7563" opacity="0.65">
      <rect x="1192" y="556" width="132" height="5" rx="2.5" />
      <rect x="1192" y="566" width="94" height="5" rx="2.5" />
    </g>
    <rect x="1352" y="554" width="112" height="9" rx="4.5" fill="#6E6653" opacity="0.5" />
    <circle class="figure__led" cx="1462" cy="530" r="6.5" fill="#00E3F2" />
    <circle cx="1462" cy="530" r="16" fill="#00E3F2" opacity="0.25" filter="url(#hf-soft)" />

    <!-- Schein vor dem Glas -->
    <rect
      class="figure__bloom"
      x="1176"
      y="322"
      width="268"
      height="200"
      rx="26"
      fill="#00E3F2"
      opacity="0.16"
      filter="url(#hf-glow)"
    />
  </g>
</svg>

<style>
  .figure {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    display: block;
  }

  .figure__body,
  .figure__head {
    transform-box: fill-box;
    transform-origin: center bottom;
  }

  /* Bewegung nur, wenn die Szene wirklich aktiv ist. */
  :global(.hero__stage.is-live) .figure__body {
    animation: hf-breathe 6.5s var(--ease-in-out) infinite;
  }
  :global(.hero__stage.is-live) .figure__head {
    animation: hf-idle 9s var(--ease-in-out) infinite;
  }
  :global(.hero__stage.is-live) .figure__screen,
  :global(.hero__stage.is-live) .figure__bloom,
  :global(.hero__stage.is-live) .figure__spill {
    animation: hf-flicker 5.4s var(--ease-in-out) infinite;
  }
  :global(.hero__stage.is-live) .figure__scan {
    animation: hf-scan 8s linear infinite;
  }
  :global(.hero__stage.is-live) .figure__led {
    animation: hf-led 4.2s var(--ease-in-out) infinite;
  }

  .figure__word {
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .figure__word.is-swapping {
    opacity: 0;
  }

  /* Atmen: minimale vertikale Bewegung. */
  @keyframes hf-breathe {
    0%,
    100% {
      transform: translateY(0) scaleY(1);
    }
    45% {
      transform: translateY(-4px) scaleY(1.004);
    }
  }
  /* Kopf folgt dem Atem leicht verzögert, kaum merkliche Neigung. */
  @keyframes hf-idle {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg);
    }
    35% {
      transform: translate(-3px, -5px) rotate(-0.3deg);
    }
    70% {
      transform: translate(2px, -2px) rotate(0.18deg);
    }
  }
  /* Analoges Helligkeitsatmen – kein harter Glitch. */
  @keyframes hf-flicker {
    0%,
    100% {
      filter: brightness(1);
    }
    22% {
      filter: brightness(1.055);
    }
    48% {
      filter: brightness(0.97);
    }
    53% {
      filter: brightness(1.025);
    }
    78% {
      filter: brightness(0.99);
    }
  }
  @keyframes hf-scan {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(5px);
    }
  }
  @keyframes hf-led {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figure__body,
    .figure__head,
    .figure__screen,
    .figure__bloom,
    .figure__spill,
    .figure__scan,
    .figure__led {
      animation: none !important;
    }
  }
</style>
