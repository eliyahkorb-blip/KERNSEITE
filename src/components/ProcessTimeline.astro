---
/**
 * ProcessTimeline – editoriale, vertikale Zeitachse.
 *
 * Ohne Kästen und ohne dekorative Nummern: Die Schritte stehen gleichmäßig
 * untereinander; die Reihenfolge ergibt sich aus der Leserichtung. Wer was
 * beiträgt, steht als ganzer Satz da – nicht als technisches Mini-Label.
 */
export interface ProcessStep {
  readonly title: string;
  /** Was passiert in diesem Schritt? */
  readonly what: string;
  /** Was liefert der Kunde? */
  readonly you: string;
  /** Was übernimmt KERNSEITE? */
  readonly us: string;
  /** Was entsteht? */
  readonly result: string;
}

interface Props {
  steps: readonly ProcessStep[];
  /** Ebene der Schritt-Überschriften (abhängig vom Seitenkontext). */
  headingLevel?: 'h2' | 'h3';
  /**
   * Kompakt: nur Schritt und Beschreibung. Auf der Startseite genügt das –
   * wer was beiträgt, steht ausführlich auf `/prozess/`.
   */
  compact?: boolean;
}
const { steps, headingLevel = 'h3', compact = false } = Astro.props;
const Tag = headingLevel;
---

<ol class="tl" role="list">
  {
    steps.map((s) => (
      <li class="tl__step">
        <div class="tl__body">
          <Tag class="tl__title">{s.title}</Tag>
          <p class="tl__what">{s.what}</p>
          {!compact && (
            <ul class="tl__share" role="list">
              <li>
                <span class="tl__who">Du bringst mit:</span> {s.you}
              </li>
              <li>
                <span class="tl__who">Wir übernehmen:</span> {s.us}
              </li>
              <li>
                <span class="tl__who">Am Ende steht:</span> {s.result}
              </li>
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .tl {
    display: grid;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tl__step {
    min-width: 0;
  }
  .tl__body {
    display: grid;
    gap: 1rem;
  }
  .tl__title {
    font-size: var(--fs-h4);
    line-height: 1.3;
  }
  .tl__what {
    color: var(--text-muted);
    max-width: 52ch;
  }
  .tl__share {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 58ch;
    font-size: 1rem;
    color: var(--text-muted);
  }
  .tl__who {
    color: var(--text);
    font-weight: 500;
  }
  @media (min-width: 64rem) {
    .tl__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 0.75rem 4rem;
    }
    .tl__title,
    .tl__what {
      grid-column: 1;
    }
    .tl__share {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
