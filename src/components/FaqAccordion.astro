---
import type { FaqItem } from '../config/faq';

interface Props {
  items: readonly FaqItem[];
  /** Erstes Element geöffnet darstellen. */
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {
    items.map((item, i) => (
      <details class="faq__item" open={openFirst && i === 0}>
        <summary class="faq__summary">
          <span class="faq__q">{item.question}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  /* Editorial statt Kachel-Akkordeon: feine Linien, viel Ruhe. */
  .faq {
    display: grid;
    gap: 0;
    border-block-start: 1px solid var(--border);
  }
  .faq__item {
    border-block-end: 1px solid var(--border);
  }
  .faq__summary {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h4);
    letter-spacing: -0.01em;
  }
  .faq__summary::-webkit-details-marker {
    display: none;
  }
  .faq__summary:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .faq__q {
    max-width: 46ch;
  }
  .faq__icon {
    position: relative;
    flex: none;
    inline-size: 18px;
    block-size: 18px;
    align-self: center;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    background: var(--brand);
    transform: translate(-50%, -50%);
  }
  .faq__icon::before {
    inline-size: 14px;
    block-size: 1.5px;
  }
  .faq__icon::after {
    inline-size: 1.5px;
    block-size: 14px;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .faq__item[open] .faq__icon::after {
    transform: translate(-50%, -50%) scaleY(0);
  }
  .faq__answer {
    padding-block-end: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .section--dark .faq,
  .section--dark .faq__item {
    border-color: var(--border-invert);
  }
  .section--dark .faq__icon::before,
  .section--dark .faq__icon::after {
    background: var(--color-cyan);
  }
</style>
