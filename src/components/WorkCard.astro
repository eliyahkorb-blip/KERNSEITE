---
import type { Work } from '../config/cases';
import CaseMockup from './CaseMockup.astro';
import ReferenceImage from './ReferenceImage.astro';

interface Props {
  work: Work;
}
const { work } = Astro.props;
---

<li class="workcard-li" data-filters={work.filters.join(' ')}>
  <article class="workcard">
    <a class="workcard__link" href={work.href}>
      <div class="workcard__media">
        {
          work.kind === 'project' ? (
            <ReferenceImage
              shot={work.screenshotDesktop}
              variant="desktop"
              pending={!work.verified}
            />
          ) : (
            <CaseMockup
              theme={work.mockupTheme}
              brand={work.title}
              tagline={work.tagline}
              industryLabel={work.industryLabel}
            />
          )
        }
      </div>
      <div class="workcard__meta">
        <p class="workcard__cat">
          {work.kind === 'project' ? work.category : work.industryLabel}
        </p>
        <h2 class="workcard__title">{work.title}</h2>
        <p class="workcard__tagline">{work.tagline}</p>
        {work.kind === 'concept' && <span class="badge badge--concept">{work.badge}</span>}
        <span class="workcard__cta">
          {work.kind === 'project' ? 'Projekt ansehen' : 'Konzeptstudie ansehen'}{' '}
          <span class="arrow" aria-hidden="true">→</span>
        </span>
      </div>
    </a>
    {
      work.kind === 'project' && (
        <a class="workcard__live" href={work.liveUrl} target="_blank" rel="noopener noreferrer">
          Live ansehen: {work.liveLabel}
        </a>
      )
    }
  </article>
</li>

<style>
  .workcard-li[hidden] {
    display: none;
  }
  .workcard {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .workcard__link {
    display: block;
    text-decoration: none;
    color: var(--text);
  }
  .workcard__media {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .workcard__link:hover .workcard__media {
    transform: translateY(-4px);
  }
  .workcard__meta {
    margin-block-start: var(--space-xl);
  }
  .workcard__cat {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .workcard__title {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-h3);
    max-width: 22ch;
  }
  .workcard__tagline {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
    max-width: 46ch;
  }
  .workcard__meta .badge {
    margin-block-start: var(--space-md);
  }
  .workcard__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    border-block-end: 1px solid var(--border-strong);
    padding-block-end: 0.3rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .workcard__cta .arrow {
    color: var(--brand);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .workcard__link:hover .workcard__cta {
    border-block-end-color: var(--accent);
  }
  .workcard__link:hover .workcard__cta .arrow {
    transform: translateX(4px);
  }
  .workcard__live {
    margin-block-start: var(--space-md);
    font-size: var(--fs-small);
    font-family: var(--font-mono);
    color: var(--brand);
  }
</style>
