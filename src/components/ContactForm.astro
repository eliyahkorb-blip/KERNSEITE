---
import { services } from '../config/services';
import { industries } from '../config/industries';
import { IS_PREVIEW } from '../lib/build-mode';
import { activeCompany } from '../lib/config-validation';
const serviceKeys = services.map((s) => s.key);
const branchSlugs = industries.map((i) => i.slug);
const branchLabels = Object.fromEntries(industries.map((i) => [i.slug, i.label]));
const ACTION = '/api/contact.php';
const scopes = [
  'Noch offen',
  'Einzelne Landingpage / Onepager',
  'Unternehmenswebsite',
  'Umfangreicher Relaunch',
];
const timings = [
  'So bald wie möglich',
  'In den nächsten 3 Monaten',
  'In 3–6 Monaten',
  'Noch offen',
];
---

<form
  class="cform"
  method="post"
  action={IS_PREVIEW ? '#' : ACTION}
  data-contact-form
  data-preview={IS_PREVIEW ? '' : undefined}
  data-service-keys={serviceKeys.join(',')}
  data-branch-slugs={branchSlugs.join(',')}
  data-branch-labels={JSON.stringify(branchLabels)}
>
  {
    IS_PREVIEW && (
      <p class="cform__preview">
        <strong>Vorschau: Der Formularversand ist noch nicht eingerichtet.</strong> Du kannst uns
        per E-Mail an <a href={`mailto:${activeCompany.email}`}>{activeCompany.email}</a> oder unter{' '}
        <a href={`tel:${activeCompany.phone.replace(/[^\d+]/g, '')}`}>{activeCompany.phone}</a>{' '}
        erreichen. Eingaben auf dieser Vorschauseite werden nicht versendet.
      </p>
    )
  }
  <div class="cform__hp" aria-hidden="true">
    <label for="cf-website2">Bitte dieses Feld frei lassen</label><input
      id="cf-website2"
      name="website2"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <input type="hidden" name="rendered_at" data-rendered-at value="" />
  <input type="hidden" name="branch" value="" data-branch-field />
  <div class="cform__grid">
    <div class="field">
      <label for="cf-name">Dein Name *</label><input
        id="cf-name"
        name="name"
        type="text"
        autocomplete="name"
        maxlength="120"
        required
      />
    </div>
    <div class="field">
      <label for="cf-email">Deine E-Mail *</label><input
        id="cf-email"
        name="email"
        type="email"
        autocomplete="email"
        maxlength="200"
        required
      />
    </div>
    <div class="field">
      <label for="cf-existing">Bestehende Website <span class="field__opt">optional</span></label
      ><input
        id="cf-existing"
        name="existing_site"
        type="text"
        inputmode="url"
        maxlength="300"
        placeholder="www.dein-unternehmen.de"
      />
    </div>
    <div class="field">
      <label for="cf-budget">Geplantes Budget <span class="field__opt">optional</span></label
      ><select id="cf-budget" name="budget"
        ><option value="">Noch offen</option><option>1.500–2.400 € netto</option><option
          >2.400–3.600 € netto</option
        ><option>Mehr als 3.600 € netto</option></select
      >
    </div>
    <div class="field field--full">
      <label for="cf-message">Worum geht es? *</label><textarea
        id="cf-message"
        name="message"
        rows="5"
        minlength="10"
        maxlength="5000"
        required
        aria-describedby="cf-message-hint"></textarea><p id="cf-message-hint" class="field__hint">
        Was bietet dein Unternehmen an, und was soll die neue Website erreichen? Ein paar Sätze
        reichen.
      </p>
    </div>
  </div>
  <details class="cform__details">
    <summary>Weitere Angaben ergänzen <span class="field__opt">optional</span></summary><div
      class="cform__grid"
    >
      <div class="field">
        <label for="cf-company">Unternehmen</label><input
          id="cf-company"
          name="company"
          type="text"
          autocomplete="organization"
          maxlength="160"
        />
      </div>
      <div class="field">
        <label for="cf-phone">Telefon</label><input
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="60"
        />
      </div>
      <div class="field">
        <label for="cf-service">Gewünschte Leistung</label><select id="cf-service" name="service"
          ><option value="">Bitte wählen …</option>{
            services.map((s) => (
              <option value={s.label} data-key={s.key}>
                {s.cardTitle}
              </option>
            ))
          }<option value="Noch unklar">Noch unklar</option></select
        >
      </div>
      <div class="field">
        <label for="cf-scope">Projektumfang</label><select id="cf-scope" name="scope"
          ><option value="">Bitte wählen …</option>{
            scopes.map((s) => <option value={s}>{s}</option>)
          }</select
        >
      </div>
      <div class="field">
        <label for="cf-timing">Gewünschter Start</label><select id="cf-timing" name="timing"
          ><option value="">Bitte wählen …</option>{
            timings.map((t) => <option value={t}>{t}</option>)
          }</select
        >
      </div>
    </div>
  </details>
  <p class="cform__privacy">
    * Pflichtfelder. Mit dem Absenden verarbeiten wir deine Angaben zur Bearbeitung deiner Anfrage.
    Weitere Informationen findest du in der <a href="/datenschutz/">Datenschutzerklärung</a>.
  </p>
  <div class="cform__actions">
    <button type="submit" class="btn btn--primary" data-submit disabled={IS_PREVIEW}
      >{IS_PREVIEW ? 'Versand erst auf der Live-Website' : 'Unverbindliche Anfrage senden'}</button
    >
  </div>
  <p class="cform__status" role="status" aria-live="polite" data-status></p>
</form>

<style>
  .cform__preview {
    padding: 1rem;
    background: var(--ks-surface);
    font-size: 0.875rem;
    margin-block-end: 1.5rem;
  }
  .cform__preview strong {
    display: block;
    margin-block-end: 0.4rem;
  }
  .cform__details {
    margin-block-start: 1.5rem;
    border-block: 1px solid var(--line);
  }
  .cform__details summary {
    padding-block: 1rem;
    cursor: pointer;
    font-size: 0.9375rem;
  }
  .cform__details .cform__grid {
    padding-block: 0.5rem 1.5rem;
  }

  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cform__grid {
    display: grid;
    gap: var(--space-lg);
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
  }
  .field__req {
    color: var(--accent-ink);
  }
  .field__opt {
    color: var(--text-muted);
    font-weight: var(--fw-regular);
    font-size: 0.8rem;
  }
  /* Ohne min-inline-size behalten Felder ihre Standardbreite (~20 Zeichen)
     und sprengen sehr schmale Viewports. */
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-inline-size: 0;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: var(--ks-cream);
    font-size: var(--fs-body);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--accent-mark);
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field [aria-invalid='true'] {
    border-color: var(--accent-mark);
  }
  .field__hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .field__error {
    font-size: 0.8rem;
    color: #a3271a;
  }
  .cform__privacy {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .cform__actions {
    margin-block-start: var(--space-lg);
  }
  .cform__status {
    margin-block-start: var(--space-md);
    font-size: var(--fs-small);
  }
  .cform__status[data-state='ok'] {
    color: #1a7a3c;
  }
  .cform__status[data-state='error'] {
    color: #a3271a;
  }

  @media (min-width: 40rem) {
    .cform__grid {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Progressive Enhancement: Ohne JS funktioniert das Formular als normaler POST an PHP.
  // Mit JS: Client-Validierung, Absenden per fetch, Statusmeldung in Live-Region.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  /**
   * Kontext aus der Adresszeile vorbelegen – ausschließlich über Whitelist.
   *
   * Der Wert aus `?leistung=` / `?branche=` wird nur zum Vergleich benutzt.
   * Gesetzt wird immer der Wert aus der serverseitig erzeugten Liste, nie der
   * Wert aus der URL. Kein Schreiben in innerHTML, keine Ausgabe im Text.
   */
  if (form) {
    const params = new URLSearchParams(window.location.search);

    const wunschLeistung = params.get('leistung');
    const erlaubteKeys = (form.dataset.serviceKeys ?? '').split(',').filter(Boolean);
    if (wunschLeistung && erlaubteKeys.includes(wunschLeistung)) {
      const select = form.querySelector<HTMLSelectElement>('#cf-service');
      const treffer = select?.querySelector<HTMLOptionElement>(
        `option[data-key="${CSS.escape(wunschLeistung)}"]`,
      );
      if (select && treffer) select.value = treffer.value;
    }

    const wunschBranche = params.get('branche');
    const erlaubteSlugs = (form.dataset.branchSlugs ?? '').split(',').filter(Boolean);
    if (wunschBranche && erlaubteSlugs.includes(wunschBranche)) {
      const feld = form.querySelector<HTMLInputElement>('[data-branch-field]');
      let labels: Record<string, string> = {};
      try {
        labels = JSON.parse(form.dataset.branchLabels ?? '{}');
      } catch {
        /* ohne Beschriftungen bleibt der Slug – beides stammt aus der Whitelist */
      }
      // Index aus der Whitelist, nicht der Rohwert aus der Adresszeile.
      const slug = erlaubteSlugs[erlaubteSlugs.indexOf(wunschBranche)];
      if (feld) feld.value = labels[slug] ?? slug;
    }
  }

  if (form && form.dataset.preview !== undefined) {
    // Vorschaumodus: niemals senden, nur eine Hinweismeldung anzeigen.
    const status = form.querySelector<HTMLElement>('[data-status]');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (status) {
        status.dataset.state = '';
        status.textContent =
          'Vorschaumodus: Es wird keine Nachricht gesendet. Auf der Live-Website funktioniert das Formular normal.';
      }
    });
  } else if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const renderedAt = form.querySelector<HTMLInputElement>('[data-rendered-at]');
    if (renderedAt) renderedAt.value = String(Date.now());

    const setError = (field: HTMLElement, message: string | null) => {
      const wrap = field.closest('.field');
      let err = wrap?.querySelector<HTMLElement>('.field__error');
      if (message) {
        field.setAttribute('aria-invalid', 'true');
        if (!err && wrap) {
          err = document.createElement('p');
          err.className = 'field__error';
          err.id = field.id + '-error';
          const hint = field.getAttribute('aria-describedby');
          field.dataset.originalDescribedby = hint ?? '';
          field.setAttribute('aria-describedby', [hint, err.id].filter(Boolean).join(' '));
          wrap.appendChild(err);
        }
        if (err) err.textContent = message;
      } else {
        field.removeAttribute('aria-invalid');
        if (err) {
          const hint = field.dataset.originalDescribedby;
          if (hint) field.setAttribute('aria-describedby', hint);
          else field.removeAttribute('aria-describedby');
          err.remove();
        }
      }
    };

    const validate = (): boolean => {
      let ok = true;
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const email = form.elements.namedItem('email') as HTMLInputElement;
      const message = form.elements.namedItem('message') as HTMLTextAreaElement;

      if (!name.value.trim()) {
        setError(name, 'Bitte gib deinen Namen an.');
        ok = false;
      } else setError(name, null);

      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim());
      if (!emailOk) {
        setError(email, 'Bitte gib eine gültige E-Mail-Adresse an.');
        ok = false;
      } else setError(email, null);

      if (message.value.trim().length < 10) {
        setError(message, 'Bitte beschreibe dein Vorhaben kurz (mind. 10 Zeichen).');
        ok = false;
      } else setError(message, null);

      return ok;
    };

    form.addEventListener('submit', async (event) => {
      if (!validate()) {
        event.preventDefault();
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        if (status) {
          status.dataset.state = 'error';
          status.textContent = 'Bitte prüfe die markierten Felder.';
        }
        return;
      }

      // JS-gestützter Versand
      event.preventDefault();
      if (submit) submit.disabled = true;
      if (status) {
        status.dataset.state = '';
        status.textContent = 'Anfrage wird gesendet …';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: AbortSignal.timeout(20000),
        });
        if (!response.headers.get('content-type')?.includes('application/json')) {
          throw new Error('Unerwartete Serverantwort');
        }
        const data = await response.json();
        if (response.ok && data?.ok === true) {
          if (status) {
            status.dataset.state = 'ok';
            status.textContent =
              'Danke! Deine Anfrage ist eingegangen. Wir melden uns so bald wie möglich.';
          }
          form.reset();
          if (renderedAt) renderedAt.value = String(Date.now());
        } else {
          if (response.status === 429 && status) {
            status.dataset.state = 'error';
            status.textContent =
              'Bitte warte einen Moment und versuche es erneut. Bei wiederholten Fehlern erreichst du uns direkt per E-Mail oder Telefon.';
            return;
          }
          throw new Error('Versand fehlgeschlagen');
        }
      } catch {
        if (status) {
          status.dataset.state = 'error';
          status.textContent =
            'Das hat leider nicht geklappt. Bitte versuche es erneut oder schreib uns direkt per E-Mail.';
        }
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
