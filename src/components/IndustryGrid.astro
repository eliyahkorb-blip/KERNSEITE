---
/**
 * IndustryGrid – geordnetes Branchenraster.
 *
 * Alle fünf Branchen haben denselben Aufbau: Bildfläche im Format 4:3,
 * Branchenname, ein kurzes Argument, Pfeillink. Keine Karte, kein Rahmen,
 * kein Schatten, keine Nummer, kein Badge, keine Kategoriezeile.
 *
 * Bilder zeigen das jeweilige Gewerk. Kunden-Screenshots werden hier nicht
 * verwendet – die gehören in den Bereich „Arbeiten“. Liegt ein Motiv noch
 * nicht vor, erscheint der Eintrag ohne Bildfläche; es gibt weder graue
 * Platzhalter noch schwarze Ersatzlinien.
 */
import { industries } from '../config/industries';
import { resolveIndustryMotif } from '../lib/industry-media';

const items = industries.map((ind) => ({ ...ind, motif: resolveIndustryMotif(ind.slug) }));
---

<ul class="igrid" role="list">
  {
    items.map((ind) => (
      <li class="igrid__cell">
        <a class="igrid__link" href={ind.href}>
          {ind.motif && (
            <span class="igrid__media">
              <picture>
                {ind.motif.avifSrcset && (
                  <source type="image/avif" srcset={ind.motif.avifSrcset} sizes={ind.motif.sizes} />
                )}
                <source type="image/webp" srcset={ind.motif.webpSrcset} sizes={ind.motif.sizes} />
                <img
                  src={ind.motif.src}
                  alt={ind.motif.alt}
                  width={ind.motif.width}
                  height={ind.motif.height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </span>
          )}
          <span class="igrid__name">{ind.title}</span>
          <span class="igrid__arg">{ind.argument}</span>
          <span class="igrid__go" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .igrid {
    display: grid;
    gap: clamp(4rem, 3rem + 3vw, 6rem) clamp(1.75rem, 1rem + 2vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .igrid__link {
    display: grid;
    /* Bild – Name – Argument – Pfeil, in festen Abständen. */
    grid-template-rows: auto auto 1fr auto;
    gap: 0;
    text-decoration: none;
    color: var(--text);
    block-size: 100%;
  }
  .igrid__link:hover {
    color: var(--text);
  }

  /* Einheitliches Bildfenster für alle Branchen. */
  .igrid__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-image);
    background: var(--ks-surface);
    margin-block-end: 1.5rem;
  }
  .igrid__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .igrid__link:hover .igrid__media img,
  .igrid__link:focus-visible .igrid__media img {
    transform: scale(1.025);
  }

  .igrid__name {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: var(--track-display);
    /* Feine Neon-Linie beim Hover statt Kachelrahmen. */
    padding-block-end: 0.35rem;
    border-block-end: 2px solid transparent;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__name,
  .igrid__link:focus-visible .igrid__name {
    border-block-end-color: var(--accent);
  }

  .igrid__arg {
    margin-block-start: 0.9rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
    max-width: 34ch;
  }

  .igrid__go {
    justify-self: start;
    margin-block-start: 1.5rem;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--accent-mark);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__go,
  .igrid__link:focus-visible .igrid__go {
    transform: translateX(6px);
  }

  /* Tablet: zwei Spalten, letzter Eintrag halbbreit statt über die Kante. */
  @media (min-width: 48rem) {
    .igrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop: drei Spalten – erste Reihe drei, zweite Reihe zwei Einträge. */
  @media (min-width: 69rem) {
    .igrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
