---
/**
 * IndustryGrid – geordnetes Branchenraster.
 *
 * Alle fünf Branchen haben denselben Aufbau: Bildfläche im Format 4:3,
 * Branchenname, ein kurzes Argument, Pfeillink. Keine Karte, kein Rahmen,
 * kein Schatten, keine Nummer, kein Badge, keine Kategoriezeile.
 *
 * Bilder zeigen das jeweilige Gewerk. Kunden-Screenshots werden hier nicht
 * verwendet – die gehören in den Bereich „Arbeiten“. Liegt ein Motiv noch
 * nicht vor, bleibt der Platz des Bildfensters leer: keine graue Fläche,
 * kein Rahmen, kein Ersatzmotiv – nur unbemalter Raum, damit Name, Argument
 * und Pfeil auf derselben Linie stehen wie bei den übrigen Einträgen.
 */
import { industries } from '../config/industries';
import Photo from './Photo.astro';
import { photos, type PhotoKey } from '../config/photos';
import { resolvePhoto } from '../lib/photo';

const items = industries.map((ind) => ({
  ...ind,
  photo: (ind.slug in photos && resolvePhoto(ind.slug as PhotoKey)
    ? ind.slug
    : null) as PhotoKey | null,
}));
---

<ul class="igrid" role="list">
  {
    items.map((ind) => (
      <li class="igrid__cell">
        <a class:list={['igrid__link', !ind.photo && 'igrid__link--nomedia']} href={ind.href}>
          {ind.photo ? (
            <Photo
              photo={ind.photo}
              ratio="4x3"
              sizes="(min-width: 69rem) 30vw, (min-width: 48rem) 46vw, 100vw"
              class="igrid__media"
            />
          ) : (
            <span class="igrid__gap" aria-hidden="true" />
          )}
          <span class="igrid__name">{ind.title}</span>
          <span class="igrid__arg">{ind.argument}</span>
          <span class="igrid__go" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .igrid {
    display: grid;
    gap: clamp(4rem, 3rem + 3vw, 6rem) clamp(1.75rem, 1rem + 2vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .igrid__cell {
    /* Macht die Zelle zum Container, damit der Link die volle Zeilenhöhe
       bekommt und die Pfeile aller Einträge auf einer Linie stehen. */
    display: grid;
  }

  .igrid__link {
    display: flex;
    flex-direction: column;
    gap: 0;
    text-decoration: none;
    color: var(--text);
  }
  /* Der Pfeil sitzt am unteren Rand der Zelle. */
  .igrid__arg {
    margin-block-end: auto;
  }
  .igrid__link:hover {
    color: var(--text);
  }

  /* Fehlt das Motiv, bleibt exakt derselbe Raum frei: gleiche Breite,
     gleiches Seitenverhältnis, aber ohne Fläche, Rahmen oder Farbe.
     Dadurch beginnt der Name in jeder Rasterzeile auf derselben Höhe –
     unabhängig davon, über wie viele Zeilen das Argument läuft. */
  .igrid__gap {
    display: block;
    aspect-ratio: 4 / 3;
  }

  /* `.igrid__media` sitzt auf dem Wurzelelement der Photo-Komponente und
     trägt deren Bereichskennung, nicht die dieser Datei. Ein markierter
     Selektor greift dort nicht – deshalb `:global()`, eingegrenzt durch
     den markierten Link davor. */
  .igrid__link :global(.igrid__media img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .igrid__link:hover :global(.igrid__media img),
  .igrid__link:focus-visible :global(.igrid__media img) {
    transform: scale(1.025);
  }

  .igrid__name {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.5rem, 2.2vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: var(--track-display);
    /* Feine Neon-Linie beim Hover statt Kachelrahmen. */
    padding-block-end: 0.35rem;
    border-block-end: 2px solid transparent;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__name,
  .igrid__link:focus-visible .igrid__name {
    border-block-end-color: var(--accent);
  }

  .igrid__arg {
    margin-block-start: 0.9rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: 1.5;
    max-width: 34ch;
  }

  .igrid__go {
    align-self: flex-start;
    margin-block-start: 1.5rem;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--accent-mark);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__go,
  .igrid__link:focus-visible .igrid__go {
    transform: translateX(6px);
  }

  /* Tablet: zwei Spalten, letzter Eintrag halbbreit statt über die Kante. */
  @media (min-width: 48rem) {
    .igrid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Desktop: drei Spalten – erste Reihe drei, zweite Reihe zwei Einträge. */
  @media (min-width: 69rem) {
    .igrid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
