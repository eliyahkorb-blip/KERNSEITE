---
/**
 * IndustryGrid – asymmetrisches Branchenraster.
 *
 * Keine identischen Karten: die Felder haben unterschiedliche Breiten und
 * Höhen, der Aufbau bricht bewusst die Rasterlogik. Liegt für eine Branche ein
 * Bild unter `public/assets/branchen/<slug>.webp`, wird es verwendet; sonst
 * trägt die Fläche allein die Typografie (keine leeren Bildplatzhalter).
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { industries } from '../config/industries';
import { industryImages } from '../config/media';

// Auf das Projektverzeichnis beziehen – `import.meta.url` zeigt im Build
// nicht zuverlässig auf die Komponentendatei.
const publicDir = join(process.cwd(), 'public');
const motifFor = (slug: string) => {
  const motif = industryImages[slug];
  if (!motif) return null;
  return existsSync(join(publicDir, motif.src.replace(/^\//, ''))) ? motif : null;
};

// Feste Größenverteilung sorgt für die Asymmetrie.
const spans = ['a', 'b', 'c', 'd', 'e'] as const;
const items = industries.map((ind, i) => ({
  ...ind,
  motif: motifFor(ind.slug),
  span: spans[i % spans.length],
}));
---

<ul class="igrid" role="list">
  {
    items.map((ind) => (
      <li class:list={['igrid__cell', `igrid__cell--${ind.span}`]}>
        <a class="igrid__link" href={ind.href}>
          {ind.motif ? (
            <span class="igrid__media">
              <img
                src={ind.motif.src}
                alt={ind.motif.alt}
                width={ind.motif.width}
                height={ind.motif.height}
                loading="lazy"
                decoding="async"
              />
            </span>
          ) : (
            <span class="igrid__rule" aria-hidden="true" />
          )}
          <span class="igrid__name">{ind.title}</span>
          <span class="igrid__arg">{ind.argument}</span>
          <span class="igrid__go" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .igrid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .igrid__link {
    display: grid;
    gap: var(--space-md);
    text-decoration: none;
    color: var(--text);
    height: 100%;
    align-content: start;
  }
  .igrid__link:hover {
    color: var(--text);
  }

  /* Kein Einheitszuschnitt: Jedes Motiv behält sein eigenes Format.
     Daraus entsteht der Formatwechsel im Raster. */
  .igrid__media {
    display: block;
    overflow: hidden;
    background: var(--ks-surface);
  }
  .igrid__media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .igrid__link:hover .igrid__media img {
    transform: scale(1.03);
  }

  /* Ohne Bild trägt eine kräftige Linie die Fläche. */
  .igrid__rule {
    display: block;
    block-size: 3px;
    background: var(--ks-black);
    transition: background-color var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__rule,
  .igrid__link:focus-visible .igrid__rule {
    background: var(--accent);
  }

  .igrid__name {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.6rem, 3vw, 2.75rem);
    line-height: 1;
    letter-spacing: var(--track-display);
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .igrid__arg {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 42ch;
  }
  .igrid__go {
    justify-self: start;
    font-size: 1.25rem;
    color: var(--accent-ink);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .igrid__link:hover .igrid__go,
  .igrid__link:focus-visible .igrid__go {
    transform: translateX(7px);
  }

  /* --- Asymmetrie ab Tablet --------------------------------------------- */
  @media (min-width: 48rem) {
    .igrid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .igrid__cell--a {
      grid-column: span 7;
    }
    .igrid__cell--b {
      grid-column: span 5;
      padding-block-start: clamp(1.5rem, 4vw, 4rem);
    }
    .igrid__cell--c {
      grid-column: span 5;
    }
    .igrid__cell--d {
      grid-column: span 7;
      padding-block-start: clamp(1rem, 3vw, 3rem);
    }
    .igrid__cell--e {
      grid-column: span 8;
    }
  }
</style>
