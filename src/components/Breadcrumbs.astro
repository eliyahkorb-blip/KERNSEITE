---
export interface Crumb {
  name: string;
  path: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

{
  items.length > 1 && (
    <nav class="breadcrumbs" aria-label="Brotkrümel-Navigation">
      <ol role="list">
        {items.map((item, i) => {
          const isLast = i === items.length - 1;
          return (
            <li>
              {isLast ? (
                <span aria-current="page">{item.name}</span>
              ) : (
                <a href={item.path}>{item.name}</a>
              )}
              {!isLast && (
                <span class="breadcrumbs__sep" aria-hidden="true">
                  /
                </span>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .breadcrumbs__sep {
    color: var(--text-muted);
  }
  .section--dark .breadcrumbs ol,
  .section--dark .breadcrumbs a {
    color: var(--text-invert-muted);
  }
</style>
