---
/**
 * ProblemList – große typografische Liste mit feinen Linien.
 * Ersetzt die frühere Reihe aus fünf Boxen. Ohne Nummern: Die Aussagen sind
 * keine Reihenfolge, sondern gleichrangige Beobachtungen.
 */
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---

<ul class="plist" role="list">
  {
    items.map((item) => (
      <li class="plist__item">
        <span class="plist__mark" aria-hidden="true" />
        <span class="plist__text">{item}</span>
      </li>
    ))
  }
</ul>

<style>
  .plist {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .plist__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    border-block-end: 1px solid var(--line);
  }
  /* Feine Cyan-Linie statt Nummer – nur ein Blickanker, kein Zähler. */
  .plist__mark {
    inline-size: clamp(1.25rem, 3vw, 2.5rem);
    block-size: 2px;
    background: var(--accent-mark);
    transform: translateY(-0.4em);
  }
  .plist__text {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.35rem, 2.6vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: min(26ch, 100%);
  }

  .plist__text {
    color: var(--text);
  }
</style>
