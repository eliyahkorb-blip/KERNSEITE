---
/**
 * ProblemList – große typografische Liste mit feinen Linien.
 * Ersetzt die frühere Reihe aus fünf Boxen. Nummern in Cyan.
 */
interface Props {
  items: readonly string[];
}
const { items } = Astro.props;
---

<ol class="plist" role="list">
  {
    items.map((item, i) => (
      <li class="plist__item">
        <span class="plist__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="plist__text">{item}</span>
      </li>
    ))
  }
</ol>

<style>
  .plist {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .plist__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.25rem, 1rem + 1.6vw, 2.25rem);
    border-block-end: 1px solid var(--line);
  }
  .plist__num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    color: var(--accent-ink);
  }
  .plist__text {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.35rem, 2.6vw, 2.4rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 26ch;
  }

  .section--dark .plist,
  .section--dark .plist__item {
    border-color: var(--line-invert);
  }
  .section--dark .plist__num {
    color: var(--accent);
  }
</style>
