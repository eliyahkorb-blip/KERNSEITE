---
/**
 * HeroCinematic – zweigeteilter Hero: Text links, CRT-Motiv rechts.
 *
 * Ausgeliefert wird eine fertige Rasterdatei (`hero-kernseite-final*.webp`),
 * die aus dem Originalfoto erzeugt wurde (`scripts/build-hero-crt.py`):
 * ohne Augen, mit cyanfarbenem Bildschirm und eingebranntem Schriftzug
 * „KERNSEITE“. Es liegt kein CSS-Overlay darüber, es gibt keinen zweiten
 * Schriftzug und keinen Wortwechsel.
 *
 * Das Motiv wird vollständig gezeigt (`height: auto`), damit weder die obere
 * Bildschirmkante noch die rechte Gehäuseseite beschnitten wird.
 *
 * Liegt ein Loop-Video vor, ersetzt es das Standbild. Fehlt beides, erscheint
 * eine neutrale Fläche – niemals eine gezeichnete Ersatzfigur.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import AccentWord from './AccentWord.astro';

// Auf das Projektverzeichnis beziehen – `import.meta.url` zeigt im Build
// nicht zuverlässig auf die Komponentendatei.
const mediaDir = join(process.cwd(), 'public', 'assets', 'video');
const hasFile = (n: string) => existsSync(join(mediaDir, n));

const sources = [
  { src: '/assets/video/hero-kernseite.webm', type: 'video/webm', file: 'hero-kernseite.webm' },
  { src: '/assets/video/hero-kernseite.mp4', type: 'video/mp4', file: 'hero-kernseite.mp4' },
].filter((s) => hasFile(s.file));
const hasVideo = sources.length > 0;

/** Figurbetonter Zuschnitt – zeigt Monitor, Hemd und Jackett vollständig. */
const POSTER = '/assets/video/hero-kernseite-final-portrait.webp';
const POSTER_WIDE = '/assets/video/hero-kernseite-final.webp';
const hasPoster = hasFile('hero-kernseite-final-portrait.webp');

const ALT =
  'Person im dunklen Anzug mit weißem Hemd, deren Kopf ein alter Röhrenmonitor ist. Auf dem cyanfarbenen Bildschirm steht in schwarzen Buchstaben KERNSEITE.';
---

<section class="hero" data-hero>
  <div class="hero__inner content">
    <div class="hero__text">
      <h1 class="hero__title">
        Dein Unternehmen kann <AccentWord>mehr</AccentWord>.<br />
        Deine Website sollte es <AccentWord>zeigen</AccentWord>.
      </h1>
      <p class="hero__lead">
        KERNSEITE entwickelt individuelle Websites, lokale Sichtbarkeit und digitale Systeme für
        Unternehmen, die mehr Anfragen und weniger Aufwand wollen.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/kontakt/">Projekt besprechen</a>
        <a class="btn btn--secondary" href="/arbeiten/">Arbeiten ansehen</a>
      </div>
      <p class="hero__trust">Würzburg · Regensburg · Bayern · deutschlandweit</p>
    </div>

    <div class="hero__media">
      {
        hasVideo ? (
          <video
            class="hero__asset"
            data-hero-video
            poster={hasPoster ? POSTER : undefined}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            aria-label={ALT}
            tabindex="-1"
          >
            {sources.map((s) => (
              <source src={s.src} type={s.type} />
            ))}
          </video>
        ) : hasPoster ? (
          <img
            class="hero__asset"
            src={POSTER}
            srcset={`${POSTER} 1052w, ${POSTER_WIDE} 1672w`}
            sizes="(min-width: 64rem) 46vw, 100vw"
            width="1052"
            height="941"
            alt={ALT}
            fetchpriority="high"
            decoding="async"
          />
        ) : (
          <div class="hero__placeholder" role="img" aria-label="Bildfläche – Motiv folgt." />
        )
      }
    </div>
  </div>
</section>

<script>
  // Nur Wiedergabe-Steuerung: Pause offscreen, bei inaktivem Tab und bei
  // reduzierter Bewegung. Kein Bildschirmtext, kein Wortwechsel, kein Timer.
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
    if (!video) return;

    let inView = true;

    const sync = () => {
      const active = inView && !document.hidden && !REDUCED.matches;
      if (active) void video.play().catch(() => {});
      else video.pause();
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) inView = e.isIntersecting;
          sync();
        },
        { threshold: 0.1 },
      ).observe(hero);
    }

    document.addEventListener('visibilitychange', sync);
    REDUCED.addEventListener?.('change', sync);
    sync();
  });
</script>

<style>
  .hero {
    background: var(--ks-paper);
  }

  /* Mobil: normaler Dokumentfluss – Bild, dann Text, dann CTAs. */
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 1rem + 4vw, 3rem);
    padding-block: clamp(1.5rem, 1rem + 3vw, 3rem) clamp(3rem, 2rem + 5vw, 5rem);
  }

  .hero__media {
    order: -1; /* Bild zuerst */
  }
  .hero__asset,
  .hero__placeholder {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }
  .hero__placeholder {
    aspect-ratio: 1052 / 941;
    background: var(--ks-surface);
  }

  /* --- Text --------------------------------------------------------------- */
  .hero__title {
    font-size: clamp(2.75rem, 11.5vw, 4.25rem);
    line-height: 0.97;
    letter-spacing: -0.04em;
    /* Keine Silbentrennung: „Unternehmen“ bleibt ganz. */
    hyphens: none;
    word-break: normal;
    overflow-wrap: normal;
    text-wrap: initial;
  }
  /* Sehr starker Browser-Zoom: Titel zusätzlich verkleinern. */
  @media (max-width: 22rem) {
    .hero__title {
      font-size: clamp(1.6rem, 8.5vw, 2.4rem);
      /* Hier zählt nur, dass nichts überläuft – Trennstriche entstehen
         dabei nicht, es wird ohne Bindestrich umbrochen. */
      overflow-wrap: anywhere;
    }
  }

  .hero__lead {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ks-black-soft);
    max-width: 46ch;
  }

  .hero__ctas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-block-start: var(--space-2xl);
  }
  @media (min-width: 32.5rem) {
    .hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
      gap: var(--space-md);
    }
  }

  .hero__trust {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* --- Desktop: klare Zweiteilung ---------------------------------------- */
  @media (min-width: 64rem) {
    .hero__inner {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: clamp(2.5rem, 5vw, 5.5rem);
      min-block-size: 88svh;
      padding-block: clamp(2rem, 4vh, 4rem);
    }
    .hero__media {
      order: 0; /* rechts */
    }
    .hero__title {
      font-size: clamp(3rem, 4.9vw, 6rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
    }
    .hero__lead {
      max-width: 40ch;
    }
  }

  @media (min-width: 90rem) {
    .hero__inner {
      grid-template-columns: 1fr 1.15fr;
    }
  }
</style>
