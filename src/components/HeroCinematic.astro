---
/**
 * HeroCinematic – heller, editorialer Hero mit fotorealistischer CRT-Figur.
 *
 * Medium ist das reale Poster (`hero-kernseite-poster.webp`); liegt zusätzlich
 * ein Loop-Video vor, wird dieses verwendet. Es gibt keinen gezeichneten Ersatz.
 *
 * Über der Bildschirmfläche des Monitors liegt ein exakt positioniertes
 * HTML-Overlay in KERNSEITE-Cyan mit echtem, gestochen scharfem Text. Die
 * Position ist relativ zum Medien-Container definiert: dessen Seitenverhältnis
 * entspricht exakt dem der Bilddatei, dadurch stimmen die Prozentwerte auf
 * jeder Bildschirmgröße.
 *
 * Messwerte der Glasfläche (visuell am gerenderten Bild abgeglichen):
 *   Querformat (1672 × 941) -> left 50.3 %  top 12.8 %  width 23.3 %  height 34.0 %
 *   Zuschnitt  (1052 × 941) -> left 21.1 %  top 12.8 %  width 37.0 %  height 34.0 %
 */
import { existsSync } from 'node:fs';
import AccentWord from './AccentWord.astro';

const mediaDir = new URL('../../public/assets/video/', import.meta.url);
const hasFile = (n: string) => existsSync(new URL(n, mediaDir));

const sources = [
  { src: '/assets/video/hero-kernseite.webm', type: 'video/webm', file: 'hero-kernseite.webm' },
  { src: '/assets/video/hero-kernseite.mp4', type: 'video/mp4', file: 'hero-kernseite.mp4' },
].filter((s) => hasFile(s.file));
const hasVideo = sources.length > 0;

const POSTER = '/assets/video/hero-kernseite-poster.webp';
const POSTER_PORTRAIT = '/assets/video/hero-kernseite-poster-portrait.webp';

const words = ['KERNSEITE', 'WEBSITES', 'SEO / GEO', 'GOOGLE', 'VIDEO', 'SOCIAL', 'AUTOMATION'];
---

<section class="hero" data-hero>
  <div class="hero__inner">
    <!-- Medienfläche: Seitenverhältnis exakt wie die Quelldatei -->
    <div class="hero__media">
      {
        hasVideo ? (
          <video
            class="hero__asset"
            data-hero-video
            poster={POSTER}
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
            tabindex="-1"
          >
            {sources.map((s) => (
              <source src={s.src} type={s.type} />
            ))}
          </video>
        ) : (
          <picture>
            <source media="(max-width: 63.99rem)" srcset={POSTER_PORTRAIT} />
            <img
              class="hero__asset"
              src={POSTER}
              width="1672"
              height="941"
              alt="Person im dunklen Anzug, deren Kopf ein alter Röhrenmonitor mit leuchtendem Bildschirm ist."
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        )
      }

      <!-- Bildschirmfläche auf dem Monitor -->
      <div class="crt" data-crt aria-hidden="true">
        <span class="crt__word" data-crt-word data-words={words.join('|')}>{words[0]}</span>
        <span class="crt__scan"></span>
      </div>

      <!-- Sehr sanfte Aufhellung der freien Fläche links (kein Kasten, kein Blur) -->
      <div class="hero__wash" aria-hidden="true"></div>
    </div>

    <div class="hero__text">
      <p class="label hero__eyebrow">Digitalagentur für Websites, Sichtbarkeit &amp; Systeme</p>
      <h1 class="hero__title">
        Dein Unternehmen kann <AccentWord>mehr</AccentWord>.<br />
        Deine Website sollte es <AccentWord>zeigen</AccentWord>.
      </h1>
      <p class="hero__lead">
        KERNSEITE entwickelt individuelle Websites, lokale Sichtbarkeit und digitale Systeme für
        Unternehmen, die mehr Anfragen und weniger Aufwand wollen.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/kontakt/">Projekt besprechen</a>
        <a class="btn btn--secondary" href="/arbeiten/">Arbeiten ansehen</a>
      </div>
      <p class="hero__trust">Würzburg · Regensburg · Bayern · deutschlandweit</p>
    </div>
  </div>
</section>

<script>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const crt = hero.querySelector<HTMLElement>('[data-crt]');
    const wordEl = hero.querySelector<HTMLElement>('[data-crt-word]');
    const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]');
    const words = (wordEl?.dataset.words ?? '').split('|').filter(Boolean);

    let inView = true;
    let timer: number | undefined;
    const still = () => REDUCED.matches;

    const sync = () => {
      const active = inView && !document.hidden && !still();
      crt?.classList.toggle('is-live', active);
      if (video) {
        if (active) void video.play().catch(() => {});
        else video.pause();
      }
      // Bei reduzierter Bewegung bleibt dauerhaft „KERNSEITE“ stehen.
      if (still() && wordEl && words.length) {
        wordEl.textContent = words[0];
        wordEl.classList.remove('is-out');
      }
    };

    const cycle = () => {
      if (!wordEl || words.length < 2) return;
      let i = 0;
      timer = window.setInterval(() => {
        if (!inView || document.hidden || still()) return;
        i = (i + 1) % words.length;
        wordEl.classList.add('is-out');
        window.setTimeout(() => {
          wordEl.textContent = words[i];
          wordEl.classList.remove('is-out');
        }, 260);
      }, 2000);
    };

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          for (const e of entries) inView = e.isIntersecting;
          sync();
        },
        { threshold: 0.1 },
      ).observe(hero);
    }

    document.addEventListener('visibilitychange', sync);
    REDUCED.addEventListener?.('change', sync);
    sync();
    if (!still()) cycle();

    window.addEventListener('pagehide', () => {
      if (timer) window.clearInterval(timer);
    });
  });
</script>

<style>
  .hero {
    background: var(--ks-paper);
  }
  .hero__inner {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /* --- Medienfläche ------------------------------------------------------- */
  .hero__media {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1052 / 941; /* Mobil: Zuschnitt auf die Figur */
    background: #cfcac4;
  }
  .hero__asset {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  /* Aufhellung: unten/links heller, damit der Text sicher lesbar bleibt. */
  /* Mobil steht der Text unter dem Bild – dort braucht es keine Aufhellung,
     damit Monitor und Jackett vollständig sichtbar bleiben. */
  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: none;
  }

  /* --- Bildschirmfläche des Monitors -------------------------------------- */
  .crt {
    position: absolute;
    inset-inline-start: 21.1%;
    inset-block-start: 12.8%;
    inline-size: 37%;
    block-size: 34%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--ks-cyan);
    border-radius: 9% / 11%;
    box-shadow:
      inset 0 0 2.5vw rgba(0, 60, 66, 0.4),
      0 0 3vw rgba(0, 227, 242, 0.3);
  }
  .crt__word {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: clamp(0.5rem, 2.4vw, 1.1rem);
    letter-spacing: 0.12em;
    line-height: 1.1;
    color: var(--ks-black);
    text-align: center;
    padding-inline: 6%;
    transition: opacity 240ms var(--ease-out);
  }
  .crt__word.is-out {
    opacity: 0;
  }
  .crt__scan {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: repeating-linear-gradient(
      to bottom,
      rgba(0, 55, 60, 0.15) 0,
      rgba(0, 55, 60, 0.15) 1px,
      transparent 1px,
      transparent 3px
    );
    mix-blend-mode: multiply;
    opacity: 0.5;
  }
  .crt.is-live {
    animation: crt-breathe 5s var(--ease-in-out) infinite;
  }
  @keyframes crt-breathe {
    0%,
    100% {
      filter: brightness(1);
    }
    38% {
      filter: brightness(1.05);
    }
    64% {
      filter: brightness(0.975);
    }
  }

  /* --- Text --------------------------------------------------------------- */
  .hero__text {
    padding: clamp(2rem, 6vw, 3rem) var(--gutter) clamp(3rem, 8vw, 4.5rem);
  }
  .hero__eyebrow {
    color: var(--accent-ink);
  }
  .hero__title {
    margin-block-start: var(--space-lg);
    font-size: clamp(2.9rem, 11vw, 4.4rem);
    line-height: 0.9;
    letter-spacing: var(--track-hero);
    text-wrap: initial;
  }
  .hero__lead {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ks-black-soft);
    max-width: 46ch;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-block-start: var(--space-2xl);
  }
  .hero__trust {
    margin-block-start: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    color: var(--ks-black-soft);
  }

  /* =========================== Desktop =================================== */
  @media (min-width: 64rem) {
    .hero__media {
      aspect-ratio: 1672 / 941; /* volle Szene, Freifläche links */
    }
    .hero__wash {
      background: linear-gradient(
        to right,
        var(--ks-paper) 0%,
        rgba(244, 240, 231, 0.9) 26%,
        rgba(244, 240, 231, 0.55) 40%,
        rgba(244, 240, 231, 0) 52%
      );
    }
    .crt {
      inset-inline-start: 50.3%;
      inset-block-start: 12.8%;
      inline-size: 23.3%;
      block-size: 34%;
    }
    .crt__word {
      font-size: clamp(0.55rem, 1.05vw, 1.3rem);
    }
    /* Der Text liegt in der Freifläche, die das Bild links mitbringt. */
    .hero__text {
      position: absolute;
      inset-block-end: clamp(2.5rem, 7%, 6rem);
      inset-inline-start: 0;
      inline-size: min(46%, 44rem);
      padding: 0 var(--space-xl) 0 var(--gutter);
    }
    .hero__title {
      font-size: clamp(2.8rem, 4.7vw, 5.6rem);
    }
    .hero__lead {
      max-width: 38ch;
    }
  }

  @media (min-width: 90rem) {
    .hero__title {
      font-size: clamp(3.4rem, 4.6vw, 6rem);
    }
  }

  @media (max-width: 30rem) {
    .hero__ctas .btn {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crt {
      animation: none !important;
    }
  }
</style>
