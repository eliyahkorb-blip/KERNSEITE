---
/**
 * HeroCinematic – zweigeteilter Hero: Text links, Neon-Flow rechts.
 *
 * Das frühere CRT-Motiv (Person mit Röhrenmonitor) ist hier vollständig
 * entfallen – kein Video, kein Poster, kein Standbild, kein Platzhalter.
 * An seiner Stelle steht das interaktive Markenelement `NeonFlow`.
 *
 * Der Text bleibt unverändert und liegt im normalen Dokumentfluss. Auf Mobil
 * steht das Neon-Element zuerst, danach Überschrift, Text und Buttons.
 */
import AccentWord from './AccentWord.astro';
import NeonFlow from './NeonFlow.astro';
---

<section class="hero section--dark on-dark" data-hero>
  <div class="hero__inner content">
    <div class="hero__text">
      <h1 class="hero__title">
        Dein Unternehmen kann <AccentWord>mehr</AccentWord>.<br />
        Deine Website sollte es <AccentWord>zeigen</AccentWord>.
      </h1>
      <p class="hero__lead">
        KERNSEITE entwickelt individuelle Websites, lokale Sichtbarkeit und digitale Systeme für
        Unternehmen, die mehr Anfragen und weniger Aufwand wollen.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/kontakt/">Projekt besprechen</a>
        <a class="btn btn--secondary" href="/arbeiten/">Arbeiten ansehen</a>
      </div>
      <p class="hero__trust">Persönlich in Würzburg. Digital bundesweit.</p>
    </div>

    <div class="hero__media">
      <NeonFlow />
    </div>
  </div>
</section>

<style>
  /* Dunkle Bühne: Nur so trägt das Cyan der markierten Wörter genug
     Kontrast – ein zweiter, abgeschwächter Türkiston kommt nicht in Frage.
     Die Neonröhren wirken aus genau diesem Schwarz heraus. */
  .hero {
    background: var(--ks-black);
  }

  /* Mobil: normaler Dokumentfluss – Effekt, dann Text, dann CTAs. */
  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 1rem + 4vw, 3rem);
    padding-block: clamp(1.5rem, 1rem + 3vw, 3rem) clamp(3rem, 2rem + 5vw, 5rem);
  }

  .hero__media {
    order: -1; /* Effekt zuerst */
    min-inline-size: 0;
  }

  /* --- Text --------------------------------------------------------------- */
  .hero__title {
    font-size: clamp(2.75rem, 11.5vw, 4.25rem);
    line-height: 0.97;
    letter-spacing: -0.04em;
    /* Keine Silbentrennung: „Unternehmen“ bleibt ganz. */
    hyphens: none;
    word-break: normal;
    overflow-wrap: normal;
    text-wrap: initial;
  }
  /* Sehr starker Browser-Zoom: Titel zusätzlich verkleinern. */
  @media (max-width: 22rem) {
    .hero__title {
      font-size: clamp(1.6rem, 8.5vw, 2.4rem);
      /* Hier zählt nur, dass nichts überläuft – Trennstriche entstehen
         dabei nicht, es wird ohne Bindestrich umbrochen. */
      overflow-wrap: anywhere;
    }
  }

  .hero__lead {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-invert-muted);
    max-width: min(46ch, 100%);
  }

  .hero__ctas {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-block-start: var(--space-2xl);
  }
  @media (min-width: 32.5rem) {
    .hero__ctas {
      grid-template-columns: auto auto;
      justify-content: start;
      gap: var(--space-md);
    }
  }

  .hero__trust {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  /* --- Desktop: klare Zweiteilung ----------------------------------------
     Text links, Effekt rechts – ohne Überlappung, ohne absoluten Textblock
     über dem Canvas. */
  @media (min-width: 64rem) {
    .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 46fr) minmax(0, 54fr);
      align-items: center;
      gap: clamp(2.5rem, 5vw, 5.5rem);
      min-block-size: 88svh;
      padding-block: clamp(2rem, 4vh, 4rem);
    }
    .hero__media {
      order: 0; /* rechts */
    }
    .hero__title {
      /* 4.6vw statt 4.9vw: In der 46-Prozent-Spalte passt „Unternehmen“ bei
         1920px sonst nicht in eine Zeile und wird beschnitten. Getrennt wird
         das Wort bewusst nicht. */
      font-size: clamp(3rem, 4.6vw, 5.6rem);
      line-height: 0.95;
      letter-spacing: -0.045em;
    }
    .hero__lead {
      max-width: 40ch;
    }
  }
</style>
