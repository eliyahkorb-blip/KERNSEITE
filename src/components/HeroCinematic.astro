---
import { featuredProjects } from '../config/cases';
const project = featuredProjects[0];
---

<section class="hero section--paper" data-hero>
  <div class="content hero__inner">
    <div class="hero__text">
      <p class="eyebrow">Webdesign für Unternehmen · bundesweit</p>
      <h1 class="hero__title">Gute Arbeit.<br />Eine Website,<br />die sie zeigt.</h1>
      <p class="hero__lead">
        Du überzeugst mit deinem Unternehmen. Wir sorgen dafür, dass man das auch online erkennt –
        mit einer individuellen Website, die dein Angebot erklärt und den Weg zur Anfrage einfach
        macht.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="/kontakt/?leistung=websites"
          >Website anfragen <span aria-hidden="true">↗</span></a
        >
        <a class="hero__link" href="/arbeiten/"
          >Projekte ansehen <span aria-hidden="true">→</span></a
        >
      </div>
      <p class="hero__trust">
        Projektbudget meist 1.500–3.600 € netto · persönlicher Ansprechpartner
      </p>
    </div>
    <a class="hero__project" href={project.href} aria-label={`Referenz ansehen: ${project.title}`}>
      <div class="hero__project-head">
        <span>Ausgewählte Arbeit</span><span aria-hidden="true">01 / 02</span>
      </div>
      <div class="hero__screen">
        <img
          src={project.screenshotDesktop.src}
          srcset={project.screenshotDesktop.srcset}
          sizes="(min-width: 80rem) 620px, (min-width: 64rem) 48vw, 100vw"
          width={project.screenshotDesktop.width}
          height={project.screenshotDesktop.height}
          alt={project.screenshotDesktop.alt}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero__project-caption">
        <span><strong>{project.title}</strong><small>Webdesign · digitale Speisekarte</small></span
        ><span class="hero__go" aria-hidden="true">↗</span>
      </div>
    </a>
  </div>
  <div class="content hero__footer">
    <span>KERNSEITE · Eliyah Korb</span><span
      >Aus Erlabrunn bei Würzburg. Für Unternehmen in ganz Deutschland.</span
    >
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 5vw, 5.5rem) 0;
  }
  .hero__inner {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .hero__text {
    min-width: 0;
  }
  .hero__title {
    font-size: clamp(2.6rem, 5.1vw, 5.3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    margin-block: 1.35rem 1.5rem;
    max-width: 14ch;
  }
  .hero__lead {
    max-width: 47ch;
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
    margin-block-start: 1.75rem;
  }
  .hero__link {
    font-size: 0.9375rem;
    font-weight: 600;
    text-underline-offset: 0.3em;
  }
  .hero__trust {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-block-start: 1.25rem;
    max-width: 47ch;
  }
  .hero__project {
    display: block;
    min-width: 0;
    background: #dcd6c9;
    border: 1px solid #cec7b9;
    color: var(--ks-black);
    text-decoration: none;
    padding: clamp(1.15rem, 2.5vw, 2.5rem);
  }
  .hero__project-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.75rem;
    margin-block-end: clamp(2rem, 4vw, 4rem);
  }
  .hero__screen {
    background: #161616;
    padding: 0.5rem;
    box-shadow: 0 20px 36px -18px #10121455;
    border-radius: 6px;
  }
  .hero__screen img {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
  .hero__project-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2rem, 4vw, 4rem);
  }
  .hero__project-caption strong {
    display: block;
    font-size: 0.9375rem;
  }
  .hero__project-caption small {
    display: block;
    font-size: 0.75rem;
    margin-block-start: 0.25rem;
  }
  .hero__go {
    font-size: 1.7rem;
    transition: transform 160ms ease;
  }
  .hero__project:hover .hero__go {
    transform: translate(3px, -3px);
  }
  .hero__footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-block-start: clamp(3rem, 5vw, 5rem);
    padding-block: 1.15rem;
    border-block-start: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
  @media (max-width: 22rem) {
    .hero__title {
      font-size: 2rem;
    }
  }
</style>
