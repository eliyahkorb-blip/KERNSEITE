---
import type { CaseStudy } from '../config/cases';
import CaseMockup from './CaseMockup.astro';

interface Props {
  items: readonly CaseStudy[];
}
const { items } = Astro.props;
---

<ul class="work-grid" role="list">
  {
    items.map((c) => (
      <li class="work-grid__item">
        <a class="work-panel" href={c.href}>
          <span class="work-panel__pixels" aria-hidden="true" />
          <div class="work-panel__media">
            <CaseMockup
              theme={c.mockupTheme}
              brand={c.title}
              tagline={c.tagline}
              industryLabel={c.industryLabel}
            />
          </div>
          <div class="work-panel__meta">
            <span class="badge badge--concept">{c.badge}</span>
            <h3 class="work-panel__title">{c.title}</h3>
            <p class="work-panel__tagline">{c.tagline}</p>
            <span class="work-panel__cta arrow-link">
              Konzeptstudie ansehen{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .work-grid {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work-panel {
    position: relative;
    display: block;
    overflow: hidden;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-muted);
    text-decoration: none;
    color: var(--text);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .work-panel:hover,
  .work-panel:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-ultramarine);
    box-shadow: var(--shadow-lg);
  }
  /* Pixel-/Grid-Hover-Effekt (dezent, dekorativ) */
  .work-panel__pixels {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--color-ultramarine) 1.4px, transparent 1.6px);
    background-size: 20px 20px;
    opacity: 0;
    transform: scale(1.04);
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }
  .work-panel:hover .work-panel__pixels,
  .work-panel:focus-visible .work-panel__pixels {
    opacity: 0.16;
    transform: scale(1);
  }
  .work-panel__media {
    position: relative;
    z-index: 1;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .work-panel:hover .work-panel__media {
    transform: translateY(-2px);
  }
  .work-panel__meta {
    position: relative;
    z-index: 1;
    margin-block-start: var(--space-lg);
  }
  .work-panel__title {
    margin-block-start: 0.75rem;
    font-size: var(--fs-h3);
  }
  .work-panel__tagline {
    margin-block-start: 0.35rem;
    color: var(--text-muted);
  }
  .work-panel__cta {
    margin-block-start: 0.9rem;
    font-size: var(--fs-small);
  }

  @media (min-width: 64rem) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-panel__pixels {
      transition: none;
    }
  }
</style>
