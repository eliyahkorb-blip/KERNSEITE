---
interface Props {
  steps: readonly string[];
  ariaLabel?: string;
}
const { steps, ariaLabel = 'Projektablauf' } = Astro.props;
---

<ol class="process-band" aria-label={ariaLabel}>
  {
    steps.map((step, i) => (
      <li class="process-band__step">
        <span class="process-band__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="process-band__label">{step}</span>
      </li>
    ))
  }
</ol>

<style>
  /* Ruhiges Band aus feinen Linien statt Kacheln mit Pfeilen. */
  .process-band {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }
  .process-band__step {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    border-block-end: 1px solid var(--border);
  }
  .process-band__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    flex: none;
  }
  .process-band__label {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h4);
    letter-spacing: -0.01em;
  }

  .section--dark .process-band,
  .section--dark .process-band__step {
    border-color: var(--border-invert);
  }
  .section--dark .process-band__label {
    color: var(--text-invert);
  }
  .section--dark .process-band__num {
    color: var(--color-cyan);
  }

  @media (min-width: 48rem) {
    .process-band {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--grid-gap);
    }
  }
  @media (min-width: 64rem) {
    .process-band {
      grid-template-columns: repeat(6, 1fr);
    }
    .process-band__step {
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 1.25rem 1.5rem;
    }
    .process-band__label {
      font-size: var(--fs-body);
    }
  }
</style>
