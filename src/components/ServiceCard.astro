---
import type { Service } from '../config/services';

interface Props {
  service: Service;
  index: number;
}
const { service, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a class="service-card" href={service.href} data-core={service.isCore ? 'true' : undefined}>
  <div class="service-card__head">
    <span class="service-card__num" aria-hidden="true">{num}</span>
    {service.isCore && <span class="service-card__tag">Kernleistung</span>}
  </div>
  <h3 class="service-card__title">{service.cardTitle}</h3>
  <p class="service-card__teaser">{service.teaser}</p>
  <p class="service-card__example">{service.example}</p>
  <span class="service-card__more">
    Mehr erfahren <span class="arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    background: var(--color-bright);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .service-card:hover,
  .service-card:focus-visible {
    border-color: var(--color-ink);
  }

  .service-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .service-card__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .service-card__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand);
  }

  /* Kernleistung: minimal hervorgehoben – über eine feine Cyan-Kante, nicht über Fläche. */
  .service-card[data-core] {
    border-block-start: 2px solid var(--accent);
  }

  .service-card__title {
    font-size: var(--fs-h3);
    max-width: 18ch;
    /* lange Komposita (z. B. „Google-Unternehmensprofil“) dürfen umbrechen */
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .service-card__teaser {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
  }
  /* Redaktionelle Ergänzung – dauerhaft sichtbar statt Hover-Spielerei. */
  .service-card__example {
    margin-block-start: var(--space-lg);
    padding-block-start: var(--space-lg);
    border-block-start: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .service-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: auto;
    padding-block-start: var(--space-xl);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    color: var(--text);
  }
  .service-card__more .arrow {
    color: var(--brand);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .service-card:hover .service-card__more .arrow,
  .service-card:focus-visible .service-card__more .arrow {
    transform: translateX(4px);
  }
</style>
