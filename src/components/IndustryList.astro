---
import { industries } from '../config/industries';
---

<ul class="industry-list" role="list">
  {
    industries.map((ind, i) => (
      <li class="industry-list__item">
        <a class="industry-list__link" href={ind.href}>
          <span class="industry-list__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="industry-list__name">{ind.title}</span>
          <span class="industry-list__arg">{ind.argument}</span>
          <span class="industry-list__arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .industry-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--border);
  }
  .industry-list__link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    column-gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    row-gap: 0.5rem;
    padding-block: clamp(1.5rem, 1rem + 1.6vw, 2.5rem);
    border-block-end: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
  }
  .industry-list__num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
  .industry-list__name {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.75rem, 1rem + 3vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-tight);
    transition: color var(--dur-base) var(--ease-out);
  }
  .industry-list__arg {
    grid-column: 2;
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 52ch;
  }
  .industry-list__arrow {
    grid-column: 3;
    grid-row: 1;
    font-size: 1.35rem;
    color: var(--brand);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .industry-list__link:hover .industry-list__arrow,
  .industry-list__link:focus-visible .industry-list__arrow {
    transform: translateX(6px);
  }

  .section--dark .industry-list,
  .section--dark .industry-list__link {
    border-color: var(--border-invert);
  }
  .section--dark .industry-list__arrow {
    color: var(--color-cyan);
  }
</style>
