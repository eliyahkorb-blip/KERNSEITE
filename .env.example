# =============================================================================
# KERNSEITE – Beispiel-Umgebungsvariablen
# =============================================================================
# WICHTIG:
# - Diese Datei enthaelt NUR Beispielwerte und wird versioniert.
# - Echte Werte gehoeren in eine NICHT versionierte .env (siehe .gitignore).
# - Die produktive .env fuer das Kontaktformular liegt auf dem Server OBERHALB
#   des Webroots (public_html), niemals im oeffentlich erreichbaren Verzeichnis.
# - NIEMALS echte Zugangsdaten committen.
# =============================================================================

# --- Build / Site -----------------------------------------------------------
# Produktions-Domain (Canonicals, Sitemap, Open-Graph-URLs). Vor Live-Gang bestaetigen.
SITE_URL=https://kernseite.de

# --- Kontaktformular (server/PHP – NUR serverseitig, nicht im Frontend) -----
# SMTP-Zugang des E-Mail-Postfachs (z. B. beim deutschen Hosting-Anbieter).
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_SECURE=tls            # tls (STARTTLS, Port 587) oder ssl (Port 465)
SMTP_USER=postfach@example.de
SMTP_PASS=__NUR_AUF_DEM_SERVER_SETZEN__
SMTP_FROM=postfach@example.de
SMTP_FROM_NAME=KERNSEITE Website

# Zieladresse fuer eingehende Anfragen.
CONTACT_TO=anfrage@example.de

# Same-Origin-Schutz: exakte Origin der Live-Website (Schema + Host, ohne Slash).
ALLOWED_ORIGIN=https://kernseite.de

# Aufbewahrung/Verarbeitung – Hinweis fuer Datenschutz-Doku (in Tagen).
FORM_RETENTION_DAYS=90

# Optionales Rate-Limit (Anfragen pro IP pro Stunde).
RATE_LIMIT_PER_HOUR=5
